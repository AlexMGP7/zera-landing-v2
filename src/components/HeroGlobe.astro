---
---
<div id="hero-globe-wrap" class="relative" style="width: min(440px, 90vw); height: min(440px, 90vw); perspective: 1200px;">
  <!-- Soft outer radial glow -->
  <div class="absolute inset-[-40px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(255,77,0,0.22) 0%, rgba(255,77,0,0.05) 45%, transparent 70%); animation: pulse-slow 3.5s ease-in-out infinite;"></div>

  <!-- Decorative CSS rotating rings (kept from original brand language) -->
  <div class="absolute inset-[-14px] rounded-full pointer-events-none border border-zera-orange/20" style="animation: spin 18s linear infinite;"></div>
  <div class="absolute inset-[-28px] rounded-full pointer-events-none border border-zera-orange/10" style="animation: spin 28s linear infinite reverse;"></div>
  <div class="absolute inset-[-44px] rounded-full pointer-events-none border border-zera-orange/5" style="animation: spin 42s linear infinite;"></div>

  <!-- Three.js canvas -->
  <canvas id="hero-globe-canvas" class="absolute inset-0 w-full h-full"></canvas>

  <!-- HUD ring label -->
  <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-2 pointer-events-none z-10">
    <div class="w-8 h-px bg-zera-orange/40"></div>
    <span class="text-zera-orange/60 text-xs font-mono tracking-widest whitespace-nowrap">$ZRA NETWORK</span>
    <div class="w-8 h-px bg-zera-orange/40"></div>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const wrap = document.getElementById('hero-globe-wrap') as HTMLDivElement | null;
  const canvas = document.getElementById('hero-globe-canvas') as HTMLCanvasElement | null;
  if (wrap && canvas) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth <= 640;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: !isMobile,
      powerPreference: 'high-performance',
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.25 : 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
    camera.position.z = 5.2;

    const sceneGroup = new THREE.Group();
    scene.add(sceneGroup);

    // ── 1. Inner glowing core (icosahedron with custom shader) ──────────
    const coreGeom = new THREE.IcosahedronGeometry(1.55, isMobile ? 1 : 2);
    const coreMat = new THREE.ShaderMaterial({
      uniforms: { uTime: { value: 0 } },
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexShader: `
        varying vec3 vNormal;
        varying vec3 vPosition;
        void main() {
          vNormal = normalize(normalMatrix * normal);
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          vPosition = mv.xyz;
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        uniform float uTime;
        varying vec3 vNormal;
        varying vec3 vPosition;
        void main() {
          vec3 viewDir = normalize(-vPosition);
          float fres = pow(1.0 - max(dot(vNormal, viewDir), 0.0), 2.5);
          float scan = sin(vPosition.y * 8.0 + uTime * 1.5) * 0.5 + 0.5;
          scan = smoothstep(0.45, 0.55, scan) * 0.25;
          vec3 hot = vec3(1.0, 0.30, 0.0);
          vec3 amber = vec3(1.0, 0.55, 0.05);
          vec3 col = mix(hot, amber, fres) * (fres * 1.4 + scan);
          float alpha = fres * 0.55 + scan * 0.4;
          gl_FragColor = vec4(col, alpha);
        }
      `,
    });
    const coreMesh = new THREE.Mesh(coreGeom, coreMat);
    sceneGroup.add(coreMesh);

    // ── 2. Geodesic network (edges) ──────────────────────────────────────
    const netGeom = new THREE.IcosahedronGeometry(1.85, isMobile ? 2 : 3);
    const edgesGeom = new THREE.EdgesGeometry(netGeom);
    const edgesMat = new THREE.LineBasicMaterial({
      color: 0xff5500,
      transparent: true,
      opacity: 0.35,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const networkEdges = new THREE.LineSegments(edgesGeom, edgesMat);
    sceneGroup.add(networkEdges);

    // ── 3. Glowing nodes at vertices ─────────────────────────────────────
    const vertexSet = new Set<string>();
    const uniqueVerts: number[] = [];
    const posAttr = netGeom.attributes.position;
    for (let i = 0; i < posAttr.count; i++) {
      const x = posAttr.getX(i), y = posAttr.getY(i), z = posAttr.getZ(i);
      const key = `${x.toFixed(3)}|${y.toFixed(3)}|${z.toFixed(3)}`;
      if (!vertexSet.has(key)) {
        vertexSet.add(key);
        uniqueVerts.push(x, y, z);
      }
    }
    const nodeGeom = new THREE.BufferGeometry();
    nodeGeom.setAttribute('position', new THREE.Float32BufferAttribute(uniqueVerts, 3));
    const phases = new Float32Array(uniqueVerts.length / 3);
    for (let i = 0; i < phases.length; i++) phases[i] = Math.random() * Math.PI * 2;
    nodeGeom.setAttribute('aPhase', new THREE.Float32BufferAttribute(phases, 1));

    const nodeMat = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uPixelRatio: { value: renderer.getPixelRatio() },
      },
      transparent: true,
      depthWrite: false,
      blending: THREE.AdditiveBlending,
      vertexShader: `
        attribute float aPhase;
        uniform float uTime;
        uniform float uPixelRatio;
        varying float vPulse;
        void main() {
          float pulse = sin(uTime * 2.0 + aPhase) * 0.5 + 0.5;
          vPulse = pulse;
          vec4 mv = modelViewMatrix * vec4(position, 1.0);
          gl_PointSize = (4.0 + pulse * 6.0) * uPixelRatio * (260.0 / -mv.z);
          gl_Position = projectionMatrix * mv;
        }
      `,
      fragmentShader: `
        varying float vPulse;
        void main() {
          vec2 uv = gl_PointCoord - 0.5;
          float d = length(uv);
          float core = smoothstep(0.5, 0.0, d);
          float glow = exp(-d * 6.0) * 0.7;
          float a = (core + glow) * (0.5 + vPulse * 0.7);
          vec3 col = mix(vec3(1.0, 0.40, 0.0), vec3(1.0, 0.75, 0.20), vPulse);
          gl_FragColor = vec4(col, a);
        }
      `,
    });
    const nodes = new THREE.Points(nodeGeom, nodeMat);
    sceneGroup.add(nodes);

    // ── 4. Outer wireframe sphere (subtle grid for depth) ───────────────
    const wireGeom = new THREE.SphereGeometry(2.05, 24, 16);
    const wireEdges = new THREE.WireframeGeometry(wireGeom);
    const wireMat = new THREE.LineBasicMaterial({
      color: 0xff4d00,
      transparent: true,
      opacity: 0.07,
      depthWrite: false,
    });
    const wireSphere = new THREE.LineSegments(wireEdges, wireMat);
    sceneGroup.add(wireSphere);

    // ── 5. Orbital rings (tilted ellipses) ──────────────────────────────
    function makeOrbit(radius: number, tilt: number, color: number, opacity: number) {
      const segs = 96;
      const pts: number[] = [];
      for (let i = 0; i <= segs; i++) {
        const a = (i / segs) * Math.PI * 2;
        pts.push(Math.cos(a) * radius, 0, Math.sin(a) * radius);
      }
      const g = new THREE.BufferGeometry();
      g.setAttribute('position', new THREE.Float32BufferAttribute(pts, 3));
      const m = new THREE.LineBasicMaterial({
        color, transparent: true, opacity, blending: THREE.AdditiveBlending, depthWrite: false,
      });
      const line = new THREE.Line(g, m);
      line.rotation.x = tilt;
      return line;
    }
    const orbit1 = makeOrbit(2.4, Math.PI / 3, 0xff6a00, 0.4);
    const orbit2 = makeOrbit(2.7, -Math.PI / 4, 0xffa500, 0.25);
    sceneGroup.add(orbit1, orbit2);

    // ── 6. Travelling pulse particles on orbits ─────────────────────────
    const pulseCount = isMobile ? 3 : 6;
    const pulses: { angle: number; speed: number; radius: number; tilt: number; mesh: THREE.Mesh }[] = [];
    const pulseGeom = new THREE.SphereGeometry(0.05, 12, 12);
    for (let i = 0; i < pulseCount; i++) {
      const m = new THREE.MeshBasicMaterial({
        color: 0xffaa33,
        transparent: true,
        opacity: 0.95,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
      });
      const mesh = new THREE.Mesh(pulseGeom, m);
      sceneGroup.add(mesh);
      pulses.push({
        angle: Math.random() * Math.PI * 2,
        speed: 0.005 + Math.random() * 0.01,
        radius: i % 2 === 0 ? 2.4 : 2.7,
        tilt: i % 2 === 0 ? Math.PI / 3 : -Math.PI / 4,
        mesh,
      });
    }

    // ── 7. Centered ZERA coin sprite ────────────────────────────────────
    const loader = new THREE.TextureLoader();
    let coinSprite: THREE.Sprite | null = null;
    loader.load('/zera-landing-v2/logos/zera-logo-hero.png', (tex) => {
      tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
      const spriteMat = new THREE.SpriteMaterial({
        map: tex,
        transparent: true,
        depthWrite: false,
      });
      coinSprite = new THREE.Sprite(spriteMat);
      coinSprite.scale.set(2.2, 2.2, 1);
      scene.add(coinSprite); // not in sceneGroup so it doesn't rotate with globe
    });

    // ── Resize ───────────────────────────────────────────────────────────
    function resize() {
      const size = wrap!.clientWidth;
      renderer.setSize(size, size, false);
      camera.aspect = 1;
      camera.updateProjectionMatrix();
    }
    resize();
    window.addEventListener('resize', resize);

    // ── Mouse interaction ────────────────────────────────────────────────
    let targetRotX = 0, targetRotY = 0;
    document.addEventListener('mousemove', (e) => {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = (e.clientY / window.innerHeight) * 2 - 1;
      targetRotY = nx * 0.5;
      targetRotX = ny * 0.3;
    }, { passive: true });

    // ── Visibility guard ─────────────────────────────────────────────────
    let visible = true;
    const obs = new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0 });
    obs.observe(wrap);

    // ── Animation loop ───────────────────────────────────────────────────
    const clock = new THREE.Clock();
    let frame = 0;
    function tick() {
      requestAnimationFrame(tick);
      if (!visible) return;
      frame++;
      if (isMobile && frame % 2 !== 0) return;

      const t = clock.getElapsedTime();
      coreMat.uniforms.uTime.value = t;
      nodeMat.uniforms.uTime.value = t;

      // Auto-rotate globe
      sceneGroup.rotation.y += reducedMotion ? 0 : 0.0035;
      sceneGroup.rotation.x = Math.sin(t * 0.2) * 0.08;

      // Mouse-driven offset
      sceneGroup.rotation.y += (targetRotY - (sceneGroup.rotation.y % (Math.PI * 2))) * 0.002;
      sceneGroup.rotation.z += (targetRotX * 0.15 - sceneGroup.rotation.z) * 0.04;

      // Animate orbits + pulses
      orbit1.rotation.z += 0.001;
      orbit2.rotation.z -= 0.0015;
      for (const p of pulses) {
        p.angle += p.speed;
        const x = Math.cos(p.angle) * p.radius;
        const z = Math.sin(p.angle) * p.radius;
        // Apply tilt around X axis
        const y = z * Math.sin(p.tilt);
        const z2 = z * Math.cos(p.tilt);
        p.mesh.position.set(x, y, z2);
      }

      // Coin sprite gentle bob
      if (coinSprite) {
        coinSprite.position.y = Math.sin(t * 1.2) * 0.06;
      }

      renderer.render(scene, camera);
    }
    tick();

    // ── Scroll fade ──────────────────────────────────────────────────────
    gsap.to(wrap, {
      scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1 },
      scale: 0.75, opacity: 0, y: 30, ease: 'none',
    });

    // ── Subtle float on the whole wrapper ────────────────────────────────
    if (!reducedMotion) {
      gsap.to(wrap, { y: -16, duration: 4, repeat: -1, yoyo: true, ease: 'power1.inOut' });
    }
  }
</script>
