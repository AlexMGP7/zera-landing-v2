---
---

<section id="features" class="relative py-32 px-6 overflow-hidden" data-circuit>
  <div class="absolute inset-0 pointer-events-none">
    <img src="/zera-landing-v2/images/wasm-tech.jpg" alt="" class="w-full h-full object-cover opacity-[0.07]" />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, #030201 0%, transparent 20%, transparent 80%, #030201 100%);"></div>
  </div>

  <div class="max-w-7xl mx-auto">
    <div class="mb-16">
      <div class="section-eyebrow reveal-text">05 / Build on ZERA</div>
      <h2 class="font-display font-bold text-4xl md:text-5xl lg:text-6xl leading-[0.98] tracking-tight reveal-text max-w-4xl">
        Primitives, not platforms.<br><span class="tech-italic">You compose the rest.</span>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-6 perspective-container">
      <div data-3d-card class="feat-card tech-card tech-corners glass rounded-3xl p-8 md:p-10 border border-white/10 group reveal-card flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-zera-orange/10 flex items-center justify-center border border-zera-orange/20">
            <svg class="w-6 h-6 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="tech-module-label">MOD / 01</span>
        </div>
        <h3 class="font-display font-bold text-2xl mb-3 tracking-tight">Smart Coin Lifecycle</h3>
        <p class="text-white/60 leading-relaxed mb-6">ZERA's coin supply isn't managed through mining or printing - it's governed by community participation and fully enforced by the network itself.</p>

        <div class="mt-auto relative rounded-2xl overflow-hidden chart-shell">
          <div class="px-4 pt-3 pb-1 flex items-center gap-3">
            <span class="text-xs font-mono chart-label">
              SUPPLY 866.6M · EPOCH <span id="feat-epoch">174</span>
            </span>
          </div>
          <canvas id="supply-chart" height="150" class="w-full block"></canvas>
        </div>
      </div>

      <div data-3d-card class="feat-card tech-card tech-corners glass rounded-3xl p-8 md:p-10 border border-white/10 group reveal-card flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-zera-orange/10 flex items-center justify-center border border-zera-orange/20">
            <svg class="w-6 h-6 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <span class="tech-module-label">MOD / 02</span>
        </div>
        <h3 class="font-display font-bold text-2xl mb-3 tracking-tight">Flexible, Predictable Fees</h3>
        <p class="text-white/60 leading-relaxed mb-6">Pay transaction fees using any approved coin - not just $ZRA. The protocol settles in $ZRA underneath.</p>

        <div class="mt-auto flex items-center justify-center py-4">
          <div id="dot-grid" class="grid gap-[6px]" style="grid-template-columns: repeat(14, 1fr);"></div>
        </div>
      </div>

      <div data-3d-card class="feat-card tech-card tech-corners glass rounded-3xl p-8 md:p-10 border border-white/10 group reveal-card flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-zera-orange/10 flex items-center justify-center border border-zera-orange/20">
            <svg class="w-6 h-6 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <span class="tech-module-label">MOD / 03</span>
        </div>
        <h3 class="font-display font-bold text-2xl mb-3 tracking-tight">Treasury-Supported Network</h3>
        <p class="text-white/60 leading-relaxed mb-6">Funded through network activity and potentially other governance-implemented mechanisms. Disbursed only by vote.</p>

        <div class="mt-auto flex items-center justify-center" style="height: 210px;">
          <div class="orbital-system relative flex items-center justify-center" style="width: 240px; height: 210px;">
            <svg class="orbit-svg absolute inset-0" viewBox="0 0 240 210" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="120" cy="105" rx="58" ry="18" class="orbit-track orbit-a" />
              <ellipse cx="120" cy="105" rx="82" ry="26" class="orbit-track orbit-b" />
              <ellipse cx="120" cy="105" rx="104" ry="34" class="orbit-track orbit-c" />
            </svg>

            <div class="satellite sat-a">¢</div>
            <div class="satellite sat-b">¢</div>
            <div class="satellite sat-c">¢</div>
            <div class="satellite sat-d">¢</div>
            <div class="satellite sat-e">¢</div>

            <div class="orbital-center">Z</div>
          </div>
        </div>
      </div>

      <div data-3d-card class="feat-card tech-card tech-corners glass rounded-3xl p-8 md:p-10 border border-white/10 group reveal-card flex flex-col">
        <div class="flex items-center justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-zera-orange/10 flex items-center justify-center border border-zera-orange/20">
            <svg class="w-6 h-6 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="tech-module-label">MOD / 04</span>
        </div>
        <h3 class="font-display font-bold text-2xl mb-3 tracking-tight">Decentralized Governance</h3>
        <p class="text-white/60 leading-relaxed mb-6">Governance is entirely on-chain, with every decision made through transparent proposals, verifiable voting, and autonomous execution.</p>

        <div class="mt-auto flex items-center justify-center" style="height: 180px;">
          <div class="lightning-wrap relative flex items-center justify-center">
            <div class="lightning-glow"></div>
            <svg class="lightning-bolt relative z-10" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" style="width: 140px; height: 140px;">
              <defs>
                <linearGradient id="bolt-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#fff8e6"/>
                  <stop offset="45%" stop-color="#ffd28a"/>
                  <stop offset="100%" stop-color="#ff6a00"/>
                </linearGradient>
                <filter id="bolt-glow">
                  <feGaussianBlur stdDeviation="5" result="blur"/>
                  <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
                </filter>
              </defs>
              <path d="M70 8 L30 60 L54 60 L42 112 L90 48 L64 48 Z" fill="url(#bolt-grad)" filter="url(#bolt-glow)"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chart-shell {
    background: linear-gradient(180deg, rgba(255, 77, 0, 0.06) 0%, rgba(255, 77, 0, 0.025) 100%);
    border: 1px solid rgba(255, 77, 0, 0.15);
  }
  .chart-label {
    color: rgba(255, 120, 30, 0.92);
    background: rgba(255, 77, 0, 0.13);
    border: 1px solid rgba(255, 77, 0, 0.3);
    padding: 2px 10px;
    border-radius: 999px;
  }

  .orbital-system { perspective: 700px; }
  .orbit-svg { filter: drop-shadow(0 0 8px rgba(255, 106, 0, 0.22)); }
  .orbit-track {
    fill: none;
    stroke: rgba(255, 130, 30, 0.34);
    stroke-width: 1.2;
    stroke-dasharray: 5 8;
    animation: orbit-dash linear infinite;
  }
  .orbit-a { animation-duration: 5s; }
  .orbit-b { animation-duration: 7.8s; }
  .orbit-c { animation-duration: 10.2s; }
  @keyframes orbit-dash { to { stroke-dashoffset: -180; } }

  .orbital-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(255, 140, 40, 0.95), rgba(220, 70, 0, 0.9));
    border: 2px solid rgba(255, 140, 40, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-weight: 700;
    font-family: ui-monospace, monospace;
    box-shadow: 0 0 28px rgba(255, 90, 0, 0.7), 0 0 60px rgba(255, 90, 0, 0.25);
    animation: z-core-pulse 2.8s ease-in-out infinite;
  }
  @keyframes z-core-pulse {
    0%, 100% { box-shadow: 0 0 28px rgba(255, 90, 0, 0.7), 0 0 60px rgba(255, 90, 0, 0.25); }
    50% { box-shadow: 0 0 36px rgba(255, 120, 20, 0.95), 0 0 70px rgba(255, 90, 0, 0.4); }
  }

  .satellite {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 24px;
    height: 24px;
    margin: -12px 0 0 -12px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 140, 40, 0.75);
    background: radial-gradient(circle at 35% 30%, rgba(35, 16, 6, 0.95), rgba(16, 8, 3, 0.88));
    color: rgba(255, 170, 80, 0.95);
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px rgba(255, 90, 0, 0.45);
  }
  .sat-a { animation: sat-orbit-a 4.4s linear infinite; }
  .sat-b { animation: sat-orbit-b 6.4s linear infinite -1.4s; }
  .sat-c { animation: sat-orbit-b 6.4s linear infinite -4.2s; }
  .sat-d { animation: sat-orbit-c 8.6s linear infinite -2.2s; }
  .sat-e { animation: sat-orbit-c 8.6s linear infinite -6.1s; }
  @keyframes sat-orbit-a {
    from { transform: rotate(0deg) translateX(58px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(58px) rotate(-360deg); }
  }
  @keyframes sat-orbit-b {
    from { transform: rotate(0deg) translateX(82px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(82px) rotate(-360deg); }
  }
  @keyframes sat-orbit-c {
    from { transform: rotate(0deg) translateX(104px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(104px) rotate(-360deg); }
  }

  .lightning-wrap { width: 170px; height: 180px; }
  .lightning-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(ellipse 62% 68% at 50% 50%, rgba(255, 140, 20, 0.35), rgba(255, 77, 0, 0.14) 45%, transparent 72%);
    animation: bolt-pulse 1.9s ease-in-out infinite;
  }
  .lightning-bolt {
    transform-origin: 50% 55%;
    filter: drop-shadow(0 0 16px rgba(255, 200, 120, 0.72)) drop-shadow(0 0 38px rgba(255, 90, 0, 0.45));
    animation: bolt-flicker 2.8s steps(1, end) infinite, bolt-tilt 3.2s ease-in-out infinite;
  }
  @keyframes bolt-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.13); }
  }
  @keyframes bolt-flicker {
    0%, 85%, 100% { opacity: 1; }
    87% { opacity: 0.78; }
    89% { opacity: 1; }
    92% { opacity: 0.85; }
    95% { opacity: 1; }
  }
  @keyframes bolt-tilt {
    0%, 100% { transform: rotate(-14deg) translateY(0px); }
    50% { transform: rotate(-8deg) translateY(-3px); }
  }

  .dot-item {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }
  .dot-item.active {
    background-color: #ff6a00;
    box-shadow: 0 0 8px rgba(255, 106, 0, 0.8);
  }
  .dot-item.inactive { background-color: rgba(255, 255, 255, 0.08); }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('#features .reveal-text, #features .reveal-card');
  items.forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: { trigger: item, start: 'top 85%', toggleActions: 'play none none none' },
      y: 50,
      opacity: 0,
      duration: 0.7,
      delay: i * 0.1,
      ease: 'power3.out',
    });
  });

  (function initChart() {
    const canvas = document.getElementById('supply-chart') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const rawPts = [0.05, 0.06, 0.07, 0.085, 0.11, 0.14, 0.16, 0.19, 0.24, 0.3, 0.34, 0.39, 0.46, 0.52, 0.59, 0.65, 0.72, 0.79, 0.84, 0.91, 0.96];
    let drawProgress = 0;
    let ticker = 0;
    let started = false;
    let epoch = 174;

    function render() {
      const W = canvas.offsetWidth;
      const H = 150;
      if (canvas.width !== W || canvas.height !== H) {
        canvas.width = W;
        canvas.height = H;
      }
      ctx.clearRect(0, 0, W, H);

      const PAD_X = 18;
      const PAD_Y = 12;
      const chartW = W - PAD_X * 2;
      const chartH = H - PAD_Y * 2;

      ctx.strokeStyle = 'rgba(255,106,0,0.14)';
      ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        const y = PAD_Y + (chartH / 4) * i;
        ctx.beginPath();
        ctx.moveTo(PAD_X, y);
        ctx.lineTo(PAD_X + chartW, y);
        ctx.stroke();
      }

      const points = rawPts.map((v, i) => ({
        x: PAD_X + (i / (rawPts.length - 1)) * chartW,
        y: PAD_Y + chartH - v * chartH,
      }));

      const activeCount = Math.max(2, Math.floor(drawProgress * (points.length - 1)) + 1);
      const visible = points.slice(0, activeCount);
      if (activeCount < points.length) {
        const frac = drawProgress * (points.length - 1) - (activeCount - 1);
        const a = points[activeCount - 1];
        const b = points[activeCount];
        visible[activeCount - 1] = { x: a.x + (b.x - a.x) * frac, y: a.y + (b.y - a.y) * frac };
      }
      const last = visible[visible.length - 1];

      const fillGrad = ctx.createLinearGradient(0, PAD_Y, 0, PAD_Y + chartH);
      fillGrad.addColorStop(0, 'rgba(255,110,20,0.34)');
      fillGrad.addColorStop(1, 'rgba(255,77,0,0)');
      ctx.beginPath();
      ctx.moveTo(visible[0].x, PAD_Y + chartH);
      ctx.lineTo(visible[0].x, visible[0].y);
      for (let i = 1; i < visible.length; i++) {
        const prev = visible[i - 1];
        const cur = visible[i];
        const cx = (prev.x + cur.x) / 2;
        ctx.bezierCurveTo(cx, prev.y, cx, cur.y, cur.x, cur.y);
      }
      ctx.lineTo(last.x, PAD_Y + chartH);
      ctx.closePath();
      ctx.fillStyle = fillGrad;
      ctx.fill();

      ctx.beginPath();
      ctx.moveTo(visible[0].x, visible[0].y);
      for (let i = 1; i < visible.length; i++) {
        const prev = visible[i - 1];
        const cur = visible[i];
        const cx = (prev.x + cur.x) / 2;
        ctx.bezierCurveTo(cx, prev.y, cx, cur.y, cur.x, cur.y);
      }
      ctx.strokeStyle = '#ff7d1d';
      ctx.lineWidth = 2.1;
      ctx.shadowColor = 'rgba(255,110,20,0.9)';
      ctx.shadowBlur = 12;
      ctx.stroke();
      ctx.shadowBlur = 0;

      const shimmerX = PAD_X + ((ticker * 0.0025) % 1) * chartW;
      const shimmer = ctx.createLinearGradient(shimmerX - 30, 0, shimmerX + 30, 0);
      shimmer.addColorStop(0, 'rgba(255,255,255,0)');
      shimmer.addColorStop(0.5, 'rgba(255,190,120,0.28)');
      shimmer.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      ctx.fillStyle = shimmer;
      ctx.fillRect(PAD_X, PAD_Y, chartW, chartH);
      ctx.restore();

      const dotR = 4 + Math.sin(ticker * 0.1) * 1.2;
      const dotGlow = ctx.createRadialGradient(last.x, last.y, 0, last.x, last.y, 20);
      dotGlow.addColorStop(0, 'rgba(255,220,150,0.95)');
      dotGlow.addColorStop(0.45, 'rgba(255,110,20,0.55)');
      dotGlow.addColorStop(1, 'rgba(255,77,0,0)');
      ctx.beginPath();
      ctx.arc(last.x, last.y, 20, 0, Math.PI * 2);
      ctx.fillStyle = dotGlow;
      ctx.fill();
      ctx.beginPath();
      ctx.arc(last.x, last.y, dotR, 0, Math.PI * 2);
      ctx.fillStyle = '#fff4de';
      ctx.shadowColor = 'rgba(255,170,90,0.95)';
      ctx.shadowBlur = 12;
      ctx.fill();
      ctx.shadowBlur = 0;
    }

    function loop() {
      drawProgress = Math.min(1, drawProgress + 0.009);
      ticker += 1;
      render();
      requestAnimationFrame(loop);
    }

    ScrollTrigger.create({
      trigger: '#supply-chart',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        if (started) return;
        started = true;
        loop();
      },
    });

    setInterval(() => {
      epoch += 1;
      const el = document.getElementById('feat-epoch');
      if (el) el.textContent = String(epoch);
    }, 2200);

    window.addEventListener('resize', render);
  })();

  (function initDotGrid() {
    const grid = document.getElementById('dot-grid');
    if (!grid) return;

    const COLS = 14;
    const ROWS = 5;
    const dots: HTMLElement[] = [];
    for (let i = 0; i < COLS * ROWS; i++) {
      const d = document.createElement('div');
      d.className = 'dot-item inactive';
      grid.appendChild(d);
      dots.push(d);
    }

    let phase = 0;
    let started = false;
    const pattern = (r: number, c: number) => {
      const wave = (c + phase) % COLS;
      return wave < 5 || (r % 2 === 0 && wave < 8);
    };
    const update = () => {
      dots.forEach((d, idx) => {
        const row = Math.floor(idx / COLS);
        const col = idx % COLS;
        const on = pattern(row, col);
        d.classList.toggle('active', on);
        d.classList.toggle('inactive', !on);
      });
    };
    const run = () => {
      update();
      setInterval(() => {
        phase = (phase + 1) % COLS;
        update();
      }, 520);
    };

    ScrollTrigger.create({
      trigger: '#dot-grid',
      start: 'top 85%',
      once: true,
      onEnter: () => {
        if (started) return;
        started = true;
        run();
      },
    });
  })();
</script>
