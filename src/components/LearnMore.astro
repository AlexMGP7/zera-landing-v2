---
---

<section id="learn-more" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">Learn <span class="gradient-text">More</span></h2>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6 mb-20">
      <a href="./learn-more/zera-for-dummies-a-simple-guide" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-zera-orange/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl overflow-hidden border border-white/10 hover:border-zera-orange/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(255,77,0,0.1)]">
          <div class="h-40 bg-gradient-to-br from-zera-orange/20 to-zera-black flex items-center justify-center">
            <svg class="w-16 h-16 text-zera-orange/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-display font-bold text-lg mb-2 group-hover:text-zera-orange transition-colors">ZERA for Dummies: A Simple Guide</h3>
            <p class="text-white/50 text-sm">ZERA is a blockchain network (like Bitcoin or Ethereum) with one revolutionary difference</p>
          </div>
        </div>
      </a>
      
      <a href="./learn-more/zera-explained-a-deeper-dive" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-zera-orange/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl overflow-hidden border border-white/10 hover:border-zera-orange/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(255,77,0,0.1)]">
          <div class="h-40 bg-gradient-to-br from-zera-orange/20 to-zera-black flex items-center justify-center">
            <svg class="w-16 h-16 text-zera-orange/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-display font-bold text-lg mb-2 group-hover:text-zera-orange transition-colors">ZERA Explained: A Deeper Dive</h3>
            <p class="text-white/50 text-sm">See How ZERA Reimagines Blockchain From the Ground Up: Governance, Treasury, and Beyond</p>
          </div>
        </div>
      </a>
      
      <a href="./learn-more/zera-decentralization-by-design" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-zera-orange/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl overflow-hidden border border-white/10 hover:border-zera-orange/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(255,77,0,0.1)]">
          <div class="h-40 bg-gradient-to-br from-zera-orange/20 to-zera-black flex items-center justify-center">
            <svg class="w-16 h-16 text-zera-orange/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div class="p-6">
            <h3 class="font-display font-bold text-lg mb-2 group-hover:text-zera-orange transition-colors">ZERA: Decentralization by Design</h3>
            <p class="text-white/50 text-sm">Decentralization is not a feature of the ZERA Network — it is its foundation.</p>
          </div>
        </div>
      </a>
    </div>
    
    <!-- CTA -->
    <div class="text-center reveal-text">
      <h3 class="font-display font-bold text-3xl md:text-4xl mb-6">Start Building Today</h3>
      <p class="text-white/60 text-lg mb-8 max-w-xl mx-auto">Join our active community of ZERA developers and help us build the decentralized web.</p>
      <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-zera-orange text-white font-semibold text-lg hover:shadow-[0_0_40px_rgba(255,77,0,0.5)] hover:scale-105 transition-all duration-300" data-magnetic>
        Join Community
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('#learn-more .reveal-text, #learn-more .reveal-card');
  items.forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger: item,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.7,
      delay: i * 0.1,
      ease: 'power3.out',
    });
  });
</script>
