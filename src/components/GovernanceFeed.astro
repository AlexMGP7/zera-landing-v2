---
// Simulated governance proposals - ready for real API
const proposals = [
  {
    id: '582d30be240e...',
    title: 'Bridge Logic Contract Update Proposal',
    status: 'Active',
    token: '$BRIDGEGUARDIAN+0000',
    endsIn: '1d 10m',
    votes: { yes: 78, no: 12, abstain: 10 },
  },
  {
    id: '26d01bae0706...',
    title: 'Network Upgrade Proposal v1.0.6',
    status: 'Active',
    token: '$ZRA+0000',
    endsIn: '1d 18m',
    votes: { yes: 92, no: 5, abstain: 3 },
  },
  {
    id: '8a3f2c1d9e4b...',
    title: 'Treasury Allocation: Developer Grants Q2',
    status: 'Closed',
    token: '$ZRA+0000',
    endsIn: 'Ended',
    votes: { yes: 85, no: 8, abstain: 7 },
  },
];
---

<section id="governance-feed" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-16 gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zera-orange/10 border border-zera-orange/20 text-zera-orange text-xs font-medium mb-4">
          <span class="relative flex h-1.5 w-1.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-zera-orange opacity-75"></span>
            <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-zera-orange"></span>
          </span>
          Live Governance
        </div>
        <h2 class="font-display font-bold text-4xl md:text-5xl reveal-text">Active <span class="gradient-text">Proposals</span></h2>
      </div>
      <a href="https://zerascan.io/governance" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-zera-orange font-semibold group text-sm" data-magnetic>
        View All Proposals
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
    
    <div class="space-y-4">
      {proposals.map((proposal, i) => (
        <div class="group relative reveal-card" data-index={i}>
          <div class="absolute inset-0 bg-gradient-to-r from-zera-orange/10 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative glass rounded-2xl p-6 md:p-8 border border-white/10 hover:border-zera-orange/20 transition-all duration-500">
            <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
              <!-- Status -->
              <div class="flex-shrink-0">
                <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold ${
                  proposal.status === 'Active' 
                    ? 'bg-green-500/10 text-green-400 border border-green-500/20' 
                    : 'bg-white/5 text-white/50 border border-white/10'
                }`}>
                  <span class={`w-1.5 h-1.5 rounded-full ${proposal.status === 'Active' ? 'bg-green-400 animate-pulse' : 'bg-white/30'}`}></span>
                  {proposal.status}
                </span>
              </div>
              
              <!-- Content -->
              <div class="flex-grow min-w-0">
                <h3 class="font-display font-bold text-lg md:text-xl mb-1 group-hover:text-zera-orange transition-colors">{proposal.title}</h3>
                <div class="flex flex-wrap items-center gap-3 text-sm text-white/40">
                  <span class="font-mono">{proposal.token}</span>
                  <span>·</span>
                  <span>{proposal.id}</span>
                </div>
              </div>
              
              <!-- Voting bars -->
              <div class="flex-shrink-0 w-full md:w-48">
                <div class="flex items-center justify-between text-xs text-white/40 mb-1.5">
                  <span>{proposal.votes.yes}% Yes</span>
                  <span class="text-white/30">{proposal.endsIn}</span>
                </div>
                <div class="h-1.5 rounded-full bg-white/5 overflow-hidden flex">
                  <div class="h-full bg-green-500 rounded-l-full" style={`width: ${proposal.votes.yes}%`}></div>
                  <div class="h-full bg-red-500" style={`width: ${proposal.votes.no}%`}></div>
                  <div class="h-full bg-white/20 rounded-r-full" style={`width: ${proposal.votes.abstain}%`}></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('#governance-feed .reveal-card');
  cards.forEach((card, i) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 88%',
        toggleActions: 'play none none none',
      },
      x: -40,
      opacity: 0,
      duration: 0.8,
      delay: i * 0.15,
      ease: 'power3.out',
    });
  });
</script>
