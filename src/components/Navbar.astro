---
const navLinks = [
  { name: "Governance", href: "#governance" },
  { name: "Treasury", href: "#treasury" },
  { name: "Tokenomics", href: "#tokenomics" },
  { name: "Developers", href: "#developers" },
  { name: "Learn More", href: "#learn-more" },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 opacity-0 -translate-y-4">
  <div class="glass mx-4 mt-4 rounded-2xl px-6 py-4">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <a href="#hero" class="flex items-center gap-3 group" data-magnetic>
        <div class="w-10 h-10 relative">
          <svg viewBox="0 0 239 304" class="w-full h-full drop-shadow-[0_0_8px_rgba(255,77,0,0.6)] transition-transform duration-500 group-hover:scale-110" fill="none">
            <path d="M177.642 20.46c.523-1.959-1.865-3.363-3.322-1.954L19.558 168.062c-1.293 1.249-.409 3.438 1.39 3.438h64.89c2.047 0 3.493 2.006 2.846 3.949l-35.574 106.722c-.664 1.99 1.793 3.529 3.294 2.064l158.826-155.089c1.924-1.879.594-5.146-2.096-5.146h-60.53c-1.314 0-2.271-1.246-1.932-2.516l27.97-104.064Z" fill="#ff4d00"/>
          </svg>
        </div>
        <span class="font-display font-bold text-xl tracking-tight text-white">ZERA</span>
      </a>
      
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a href={link.href} class="relative text-sm font-medium text-white/70 hover:text-white transition-colors duration-300 group/link" data-magnetic>
            {link.name}
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-zera-orange transition-all duration-300 group-hover/link:w-full shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
          </a>
        ))}
        <a href="https://docs.zera.net/" target="_blank" rel="noopener noreferrer" class="relative text-sm font-medium text-white/70 hover:text-white transition-colors duration-300 group/link" data-magnetic>
          Docs
          <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-zera-orange transition-all duration-300 group-hover/link:w-full shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
        </a>
      </div>
      
      <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-zera-orange/10 border border-zera-orange/30 text-zera-orange text-sm font-semibold hover:bg-zera-orange hover:text-white transition-all duration-300 hover:shadow-[0_0_20px_rgba(255,77,0,0.4)]" data-magnetic>
        Join Community
      </a>
      
      <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Toggle menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
  
  <div id="mobile-menu" class="hidden md:hidden glass mx-4 mt-2 rounded-2xl p-6">
    <div class="flex flex-col gap-4">
      {navLinks.map((link) => (
        <a href={link.href} class="text-white/70 hover:text-zera-orange transition-colors font-medium">{link.name}</a>
      ))}
      <a href="https://docs.zera.net/" target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-zera-orange transition-colors font-medium">Docs</a>
      <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-zera-orange text-white text-sm font-semibold mt-2">Join Community</a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  window.addEventListener('scroll', () => {
    if (window.scrollY > 100) {
      navbar?.classList.remove('opacity-0', '-translate-y-4');
      navbar?.classList.add('opacity-100', 'translate-y-0');
    } else {
      navbar?.classList.add('opacity-0', '-translate-y-4');
      navbar?.classList.remove('opacity-100', 'translate-y-0');
    }
  });
  
  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
