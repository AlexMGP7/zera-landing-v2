---
---

<section id="overview" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-20">
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">ZERA <span class="gradient-text">Overview</span></h2>
    </div>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 perspective-container">
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Transparent Performance Tracking</h3>
        <p class="text-white/50 text-sm leading-relaxed">Monitor governance efficiency, treasury health, and community participation through clear metrics and reports.</p>
      </div>
      
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Collective Governance</h3>
        <p class="text-white/50 text-sm leading-relaxed">Protects community assets through enabling seamless adjustment to market and network conditions.</p>
      </div>
      
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Automated Proposal Execution</h3>
        <p class="text-white/50 text-sm leading-relaxed">Once approved, proposals execute transactions seamlessly on-chain with zero manual delays or bottlenecks.</p>
      </div>
      
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Real-Time Network Insights</h3>
        <p class="text-white/50 text-sm leading-relaxed">Access live analytics that give every participant full clarity on proposals, votes, and treasury activity.</p>
      </div>
      
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Treasury Support</h3>
        <p class="text-white/50 text-sm leading-relaxed">Treasury funds are used to support the ZERA protocol and governance decisions.</p>
      </div>
      
      <div data-3d-card data-tilt class="glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card">
        <div class="w-10 h-10 rounded-lg bg-zera-orange/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
          <svg class="w-5 h-5 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-lg mb-2">Multi-Asset Fee Payments</h3>
        <p class="text-white/50 text-sm leading-relaxed">Pay transaction fees using any approved currency, not just the native token — boosting accessibility.</p>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('#overview .reveal-text, #overview .reveal-card');
  items.forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger: item,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.6,
      delay: i * 0.08,
      ease: 'power3.out',
    });
  });
</script>
