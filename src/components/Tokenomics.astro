---
---

<section id="tokenomics" class="relative py-32 px-6" data-circuit>
  <!-- Subtle radial glow -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(255,77,0,0.06) 0%, transparent 70%);"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-20">
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">
        Smart Coin <span class="gradient-text">Lifecycle</span>
      </h2>
      <p class="text-white/50 text-lg max-w-2xl mx-auto reveal-text">
        ZERA's coin supply isn't managed through mining or printing — it's governed by community participation and fully enforced by the network itself.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-10 perspective-container">

      <!-- Step 01 -->
      <div data-3d-card data-tilt class="text-center reveal-card group">
        <div class="relative w-24 h-24 mx-auto mb-8">
          <div class="absolute inset-0 rounded-full border-2 border-zera-orange/30 group-hover:border-zera-orange/70 transition-colors duration-500" style="animation: spin-slow 8s linear infinite;"></div>
          <div class="absolute inset-[6px] rounded-full border border-zera-orange/20 group-hover:border-zera-orange/50 transition-colors duration-500" style="animation: spin-slow 5s linear infinite reverse;"></div>
          <div class="absolute inset-[12px] rounded-full flex items-center justify-center" style="background: radial-gradient(circle at 35% 30%, rgba(255,120,0,0.9), rgba(255,77,0,0.7)); box-shadow: 0 0 24px rgba(255,77,0,0.5), inset 0 2px 4px rgba(255,255,255,0.2);">
            <span class="font-display font-bold text-xl text-white">01</span>
          </div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-zera-amber shadow-[0_0_8px_rgba(255,165,0,0.9)]" style="top: -5px; left: calc(50% - 5px); animation: orbit-dot 3s linear infinite;"></div>
        </div>
        <h3 class="font-display font-bold text-xl mb-3 group-hover:text-zera-orange transition-colors duration-300">Community Driven</h3>
        <p class="text-white/50 leading-relaxed">Supply decisions are made through on-chain governance proposals, not by a centralized team.</p>
      </div>

      <!-- Step 02 -->
      <div data-3d-card data-tilt class="text-center reveal-card group">
        <div class="relative w-24 h-24 mx-auto mb-8">
          <div class="absolute inset-0 rounded-full border-2 border-zera-orange/30 group-hover:border-zera-orange/70 transition-colors duration-500" style="animation: spin-slow 10s linear infinite reverse;"></div>
          <div class="absolute inset-[6px] rounded-full border border-zera-orange/20 group-hover:border-zera-orange/50 transition-colors duration-500" style="animation: spin-slow 6s linear infinite;"></div>
          <div class="absolute inset-[12px] rounded-full flex items-center justify-center" style="background: radial-gradient(circle at 35% 30%, rgba(255,120,0,0.9), rgba(255,77,0,0.7)); box-shadow: 0 0 24px rgba(255,77,0,0.5), inset 0 2px 4px rgba(255,255,255,0.2);">
            <span class="font-display font-bold text-xl text-white">02</span>
          </div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-zera-amber shadow-[0_0_8px_rgba(255,165,0,0.9)]" style="top: -5px; left: calc(50% - 5px); animation: orbit-dot 4s linear infinite reverse;"></div>
        </div>
        <h3 class="font-display font-bold text-xl mb-3 group-hover:text-zera-orange transition-colors duration-300">Network Enforced</h3>
        <p class="text-white/50 leading-relaxed">All monetary policy is executed autonomously by smart contracts with zero manual intervention.</p>
      </div>

      <!-- Step 03 -->
      <div data-3d-card data-tilt class="text-center reveal-card group">
        <div class="relative w-24 h-24 mx-auto mb-8">
          <div class="absolute inset-0 rounded-full border-2 border-zera-orange/30 group-hover:border-zera-orange/70 transition-colors duration-500" style="animation: spin-slow 7s linear infinite;"></div>
          <div class="absolute inset-[6px] rounded-full border border-zera-orange/20 group-hover:border-zera-orange/50 transition-colors duration-500" style="animation: spin-slow 4s linear infinite reverse;"></div>
          <div class="absolute inset-[12px] rounded-full flex items-center justify-center" style="background: radial-gradient(circle at 35% 30%, rgba(255,120,0,0.9), rgba(255,77,0,0.7)); box-shadow: 0 0 24px rgba(255,77,0,0.5), inset 0 2px 4px rgba(255,255,255,0.2);">
            <span class="font-display font-bold text-xl text-white">03</span>
          </div>
          <div class="absolute w-2.5 h-2.5 rounded-full bg-zera-amber shadow-[0_0_8px_rgba(255,165,0,0.9)]" style="top: -5px; left: calc(50% - 5px); animation: orbit-dot 2.5s linear infinite;"></div>
        </div>
        <h3 class="font-display font-bold text-xl mb-3 group-hover:text-zera-orange transition-colors duration-300">Fully Transparent</h3>
        <p class="text-white/50 leading-relaxed">Every mint, burn, and allocation is visible on-chain for complete auditability.</p>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  @keyframes orbit-dot {
    from { transform: rotate(0deg) translateX(48px) rotate(0deg); }
    to   { transform: rotate(360deg) translateX(48px) rotate(-360deg); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('#tokenomics .reveal-text, #tokenomics .reveal-card');
  items.forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger: item,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.7,
      delay: i * 0.15,
      ease: 'power3.out',
    });
  });
</script>
