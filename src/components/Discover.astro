---
---

<section id="discover" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">Discover <span class="gradient-text">ZERA</span></h2>
      <p class="text-white/50 text-lg max-w-2xl mx-auto reveal-text">ZERA exists as a cross chain ecosystem. Find some frequently visited resources here.</p>
    </div>
    
    <div class="grid md:grid-cols-3 gap-6">
      <!-- Native ZERA -->
      <a href="#" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-zera-orange/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl p-8 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(255,77,0,0.1)]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl bg-zera-orange/10 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <h3 class="font-display font-bold text-xl">Native ZERA</h3>
          </div>
          <p class="text-white/50 text-sm mb-6">The native network coin that powers the network.</p>
          <span class="inline-flex items-center gap-1 text-zera-orange text-sm font-medium">
            View on zerascan.io
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </span>
        </div>
      </a>
      
      <!-- Wrapped ZERA (SOL) -->
      <a href="#" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-purple-500/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl p-8 border border-white/10 hover:border-purple-500/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(168,85,247,0.1)]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
              </svg>
            </div>
            <h3 class="font-display font-bold text-xl">Wrapped ZERA (SOL)</h3>
          </div>
          <p class="text-white/50 text-sm mb-6">A wrapped version of ZERA on the Solana Network</p>
          <span class="inline-flex items-center gap-1 text-purple-400 text-sm font-medium">
            View on solscan.io
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </span>
        </div>
      </a>
      
      <!-- Raydium Liquidity Pool -->
      <a href="#" class="group relative reveal-card">
        <div class="absolute inset-0 bg-gradient-to-br from-green-500/20 to-transparent rounded-2xl blur-xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative glass rounded-2xl p-8 border border-white/10 hover:border-green-500/30 transition-all duration-500 h-full hover:shadow-[0_0_30px_rgba(34,197,94,0.1)]">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <h3 class="font-display font-bold text-xl">Raydium Liquidity Pool</h3>
          </div>
          <p class="text-white/50 text-sm mb-6">The quick start to enter into the ZERA Ecosystem</p>
          <span class="inline-flex items-center gap-1 text-green-400 text-sm font-medium">
            View on dextools.io
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </span>
        </div>
      </a>
    </div>
    
    <!-- Network Explorer -->
    <div class="mt-16 text-center reveal-card">
      <div class="glass rounded-2xl p-8 border border-white/10 inline-block">
        <h3 class="font-display font-bold text-xl mb-2">Network Explorer</h3>
        <p class="text-white/50 mb-6">Check out community made network explorers to power your Web3 experience.</p>
        <a href="#" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-zera-orange/10 border border-zera-orange/30 text-zera-orange font-semibold hover:bg-zera-orange hover:text-white transition-all duration-300">
          View zerascan.io
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const items = document.querySelectorAll('#discover .reveal-text, #discover .reveal-card');
  items.forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger: item,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.7,
      delay: i * 0.1,
      ease: 'power3.out',
    });
  });
</script>
