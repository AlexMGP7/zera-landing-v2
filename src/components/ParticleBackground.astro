<div id="particles-container" class="fixed inset-0 z-0 pointer-events-none"></div>
<script>
  import * as THREE from 'three';

  const container = document.getElementById('particles-container');
  if (!container) throw new Error('No container');

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  container.appendChild(renderer.domElement);

  const isMobileBG = window.innerWidth <= 640;
  const particleCount = isMobileBG ? 180 : 400;
  const positions = new Float32Array(particleCount * 3);
  const colors = new Float32Array(particleCount * 3);
  const sizes = new Float32Array(particleCount);
  const velocities: number[][] = [];

  const color1 = new THREE.Color('#ff4d00');
  const color2 = new THREE.Color('#ffa500');
  const colorDim = new THREE.Color('#ff2200');

  for (let i = 0; i < particleCount; i++) {
    positions[i * 3]     = (Math.random() - 0.5) * 32;
    positions[i * 3 + 1] = (Math.random() - 0.5) * 32;
    positions[i * 3 + 2] = (Math.random() - 0.5) * 14;

    const t = Math.random();
    const mixedColor = t < 0.5
      ? color1.clone().lerp(color2, t * 2)
      : color2.clone().lerp(colorDim, (t - 0.5) * 2);
    colors[i * 3]     = mixedColor.r;
    colors[i * 3 + 1] = mixedColor.g;
    colors[i * 3 + 2] = mixedColor.b;

    sizes[i] = Math.random() * 2.5 + 0.4;

    velocities.push([
      (Math.random() - 0.5) * 0.003,
      (Math.random() - 0.5) * 0.003,
      (Math.random() - 0.5) * 0.001,
    ]);
  }

  const geometry = new THREE.BufferGeometry();
  geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  geometry.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

  const material = new THREE.PointsMaterial({
    size: 0.055,
    vertexColors: true,
    transparent: true,
    opacity: 0.65,
    blending: THREE.AdditiveBlending,
    sizeAttenuation: true,
    depthWrite: false,
  });

  const particles = new THREE.Points(geometry, material);
  scene.add(particles);

  // Connection lines
  const lineGeometry = new THREE.BufferGeometry();
  const maxLines = isMobileBG ? 200 : 500;
  const linePositions = new Float32Array(maxLines * 6);
  const lineColors = new Float32Array(maxLines * 6);
  lineGeometry.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
  lineGeometry.setAttribute('color', new THREE.BufferAttribute(lineColors, 3));

  const lineSegments = new THREE.LineSegments(
    lineGeometry,
    new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.18,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    })
  );
  scene.add(lineSegments);

  camera.position.z = 6;

  let mouseX = 0;
  let mouseY = 0;
  let targetMouseX = 0;
  let targetMouseY = 0;

  document.addEventListener('mousemove', (e) => {
    targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
    targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  const clock = new THREE.Clock();
  const connectionDist = 2.2;

  function updateConnections() {
    let lineIdx = 0;
    const pos = geometry.attributes.position.array as Float32Array;

    for (let i = 0; i < particleCount && lineIdx < maxLines; i++) {
      for (let j = i + 1; j < particleCount && lineIdx < maxLines; j++) {
        const dx = pos[i * 3]     - pos[j * 3];
        const dy = pos[i * 3 + 1] - pos[j * 3 + 1];
        const dz = pos[i * 3 + 2] - pos[j * 3 + 2];
        const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

        if (dist < connectionDist) {
          const alpha = (1 - dist / connectionDist) * 0.5;
          linePositions[lineIdx * 6]     = pos[i * 3];
          linePositions[lineIdx * 6 + 1] = pos[i * 3 + 1];
          linePositions[lineIdx * 6 + 2] = pos[i * 3 + 2];
          linePositions[lineIdx * 6 + 3] = pos[j * 3];
          linePositions[lineIdx * 6 + 4] = pos[j * 3 + 1];
          linePositions[lineIdx * 6 + 5] = pos[j * 3 + 2];

          lineColors[lineIdx * 6]     = 1.0 * alpha * 3;
          lineColors[lineIdx * 6 + 1] = 0.3 * alpha * 3;
          lineColors[lineIdx * 6 + 2] = 0.0;
          lineColors[lineIdx * 6 + 3] = 1.0 * alpha * 3;
          lineColors[lineIdx * 6 + 4] = 0.3 * alpha * 3;
          lineColors[lineIdx * 6 + 5] = 0.0;
          lineIdx++;
        }
      }
    }

    for (let k = lineIdx; k < maxLines; k++) {
      linePositions[k * 6] = linePositions[k * 6 + 1] = linePositions[k * 6 + 2] = 0;
      linePositions[k * 6 + 3] = linePositions[k * 6 + 4] = linePositions[k * 6 + 5] = 0;
    }

    lineGeometry.attributes.position.needsUpdate = true;
    lineGeometry.attributes.color.needsUpdate = true;
    lineGeometry.setDrawRange(0, lineIdx * 2);
  }

  let frameCount = 0;
  let canvasVisible = true;
  // Pause Three.js loop when canvas is not in viewport
  const canvasObs = new IntersectionObserver((entries) => {
    canvasVisible = entries[0].isIntersecting;
  }, { threshold: 0 });
  canvasObs.observe(renderer.domElement);

  function animate() {
    requestAnimationFrame(animate);
    const elapsed = clock.getElapsedTime();
    frameCount++;

    // Update connections every 2 frames (halves O(n²) cost)
    if (frameCount % 2 === 0) updateConnections();

    mouseX += (targetMouseX - mouseX) * 0.03;
    mouseY += (targetMouseY - mouseY) * 0.03;

    const pos = geometry.attributes.position.array as Float32Array;
    for (let i = 0; i < particleCount; i++) {
      pos[i * 3]     += velocities[i][0];
      pos[i * 3 + 1] += velocities[i][1];
      pos[i * 3 + 2] += velocities[i][2];

      if (pos[i * 3] > 16)  pos[i * 3] = -16;
      if (pos[i * 3] < -16) pos[i * 3] = 16;
      if (pos[i * 3 + 1] > 16)  pos[i * 3 + 1] = -16;
      if (pos[i * 3 + 1] < -16) pos[i * 3 + 1] = 16;
    }
    geometry.attributes.position.needsUpdate = true;

    if (frameCount % 3 === 0) updateConnections();

    particles.rotation.y = elapsed * 0.018;
    particles.rotation.x = Math.sin(elapsed * 0.08) * 0.06;
    particles.position.x += (mouseX * 0.6 - particles.position.x) * 0.025;
    particles.position.y += (mouseY * 0.6 - particles.position.y) * 0.025;

    lineSegments.position.copy(particles.position);
    lineSegments.rotation.copy(particles.rotation);

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
</script>
