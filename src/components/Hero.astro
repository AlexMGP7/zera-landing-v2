---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Deep space radial gradient -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(255,77,0,0.12) 0%, rgba(255,77,0,0.04) 40%, transparent 70%);"></div>

  <!-- Animated grid lines -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" style="background-image: linear-gradient(rgba(255,77,0,0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,77,0,0.8) 1px, transparent 1px); background-size: 80px 80px;"></div>

  <!-- Scan line sweep -->
  <div id="scan-line" class="absolute left-0 right-0 h-[2px] pointer-events-none" style="background: linear-gradient(90deg, transparent, rgba(255,77,0,0.4), transparent); top: 0;"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 pt-24 pb-16 sm:py-32 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-zera-orange/20 mb-10 reveal-item" data-reveal>
      <span class="w-2 h-2 rounded-full bg-zera-orange animate-pulse shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
      <span class="text-sm font-medium text-white/80 tracking-wide">ZERA Network</span>
    </div>

    <!-- Main Title -->
    <h1 data-3d-text class="font-display font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl leading-[1.05] tracking-tight mb-8 preserve-3d">
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word">Community-Governed.</span>
      </span>
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word gradient-text">Treasury-Supported.</span>
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-2xl mx-auto text-lg md:text-xl text-white/50 mb-14 reveal-item leading-relaxed" data-reveal>
      The ZERA Network is a modern, governance-first blockchain platform designed for high-performance, developer-friendly Web3 applications.
    </p>

    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-24 reveal-item" data-reveal>
      <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="group relative px-8 py-4 rounded-full bg-zera-orange text-white font-semibold text-lg overflow-hidden transition-all duration-300 hover:shadow-[0_0_40px_rgba(255,77,0,0.5)] hover:scale-105" data-magnetic>
        <span class="relative z-10 flex items-center gap-2">
          Join Community
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-zera-orange-light to-zera-amber opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>

      <a href="http://chatgpt.com/g/g-68a96e8daadc8191945582a504f0efe1-zera-gpt" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-full glass border border-white/10 text-white font-semibold text-lg hover:border-zera-orange/50 hover:bg-zera-orange/5 transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,77,0,0.2)]" data-magnetic>
        Try Zera GPT
      </a>
    </div>

    <!-- 3D Logo — multi-layer depth effect -->
    <div id="logo-scene" class="relative w-40 h-40 sm:w-56 sm:h-56 md:w-64 md:h-64 mx-auto mb-12" style="perspective: 900px;">
      <!-- Outer glow ring -->
      <div class="absolute inset-[-20px] rounded-full pointer-events-none animate-pulse-slow" style="background: radial-gradient(circle, rgba(255,77,0,0.18) 0%, transparent 70%);"></div>

      <!-- Rotating ring 1 -->
      <div class="absolute inset-[-8px] rounded-full pointer-events-none border border-zera-orange/15" style="animation: spin 12s linear infinite;"></div>
      <!-- Rotating ring 2 -->
      <div class="absolute inset-[-16px] rounded-full pointer-events-none border border-zera-orange/08" style="animation: spin 20s linear infinite reverse;"></div>

      <!-- Main logo image with 3D mouse tracking -->
      <div id="logo-3d" class="w-full h-full relative" style="transform-style: preserve-3d;">
        <img
          id="zera-logo-img"
          src="/zera-landing-v2/logos/zera-logo-hero.png"
          alt="ZERA Network Logo"
          class="w-full h-full object-contain select-none"
          style="filter: drop-shadow(0 0 30px rgba(255,77,0,0.45)) drop-shadow(0 0 60px rgba(255,77,0,0.2)); transition: filter 0.3s ease;"
          draggable="false"
        />
      </div>
    </div>

    <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <span class="text-xs uppercase tracking-widest text-white/50">Scroll</span>
    <div class="w-6 h-10 rounded-full border border-white/30 flex items-start justify-center p-2">
      <div class="w-1.5 h-1.5 rounded-full bg-white/70 animate-bounce"></div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Scan line sweep
  const scanLine = document.getElementById('scan-line');
  if (scanLine) {
    gsap.to(scanLine, {
      top: '100%',
      duration: 4,
      repeat: -1,
      ease: 'none',
      delay: 1,
    });
  }

  // Logo 3D mouse-tracking tilt
  const logoScene = document.getElementById('logo-scene');
  const logo3d = document.getElementById('logo-3d');
  const logoShadow = document.getElementById('logo-shadow');
  const logoShine = document.getElementById('logo-shine');

  let targetRotX = 0;
  let targetRotY = 0;
  let currentRotX = 0;
  let currentRotY = 0;

  document.addEventListener('mousemove', (e) => {
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    const dx = (e.clientX - cx) / cx;
    const dy = (e.clientY - cy) / cy;
    targetRotY = dx * 22;
    targetRotX = -dy * 18;

    if (logoShine) {
      const sx = 35 + dx * 20;
      const sy = 30 + dy * 20;
      logoShine.style.background = `radial-gradient(circle at ${sx}% ${sy}%, rgba(255,255,255,0.22) 0%, transparent 55%)`;
    }
  });

  function lerpLogo() {
    currentRotX += (targetRotX - currentRotX) * 0.06;
    currentRotY += (targetRotY - currentRotY) * 0.06;
    if (logo3d) {
      logo3d.style.transform = `rotateX(${currentRotX}deg) rotateY(${currentRotY}deg)`;
    }
    if (logoShadow) {
      const shadowX = currentRotY * 0.6;
      const shadowY = 12 + currentRotX * 0.4;
      logoShadow.style.transform = `translateZ(-40px) translateX(${shadowX}px) translateY(${shadowY}px) scale(0.88)`;
    }
    requestAnimationFrame(lerpLogo);
  }
  lerpLogo();

  // Floating animation
  if (logoScene) {
    gsap.to(logoScene, {
      y: -18,
      duration: 3.2,
      repeat: -1,
      yoyo: true,
      ease: 'power1.inOut',
    });
  }

  // Orbiting dot
  const orbitDot = document.getElementById('orbit-dot');
  if (orbitDot && logoScene) {
    const radius = logoScene.offsetWidth / 2 + 16;
    let angle = 0;
    function animateOrbit() {
      angle += 0.012;
      const x = Math.cos(angle) * radius;
      const y = Math.sin(angle) * radius;
      orbitDot.style.transform = `translate(${x}px, ${y}px)`;
      orbitDot.style.left = `calc(50% - 6px)`;
      orbitDot.style.top = `calc(50% - 6px)`;
      requestAnimationFrame(animateOrbit);
    }
    animateOrbit();
  }

  // Scroll: logo fades and scales down
  if (logoScene) {
    gsap.to(logoScene, {
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
      scale: 0.6,
      opacity: 0,
      y: 40,
      ease: 'none',
    });
  }

  // Hero title word reveal
  const heroWords = document.querySelectorAll('.hero-word');
  gsap.from(heroWords, {
    y: 120,
    opacity: 0,
    duration: 1.4,
    stagger: 0.2,
    ease: 'power4.out',
    delay: 0.5,
  });

  // Reveal animations
  const revealItems = document.querySelectorAll('#hero [data-reveal]');
  revealItems.forEach((item, i) => {
    gsap.from(item, {
      y: 50,
      opacity: 0,
      duration: 1,
      delay: 1 + i * 0.15,
      ease: 'power3.out',
    });
  });
</script>
