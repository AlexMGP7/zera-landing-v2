---
import HeroGlobe from './HeroGlobe.astro';
---
<section id="hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden">
  <!-- Background: tech image with overlay -->
  <div class="absolute inset-0 pointer-events-none">
    <img src="/zera-landing-v2/images/hero-bg-tech.jpg" alt="" class="w-full h-full object-cover opacity-20" />
    <div class="absolute inset-0" style="background: linear-gradient(to bottom, #030201 0%, transparent 20%, transparent 70%, #030201 100%);"></div>
  </div>
  <!-- Deep space radial gradient -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(255,77,0,0.10) 0%, rgba(255,77,0,0.03) 40%, transparent 70%);"></div>
  <!-- Animated grid lines -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.035]" style="background-image: linear-gradient(rgba(255,77,0,0.8) 1px, transparent 1px), linear-gradient(90deg, rgba(255,77,0,0.8) 1px, transparent 1px); background-size: 80px 80px;"></div>
  <!-- Scan line sweep -->
  <div id="scan-line" class="absolute left-0 right-0 h-[2px] pointer-events-none" style="background: linear-gradient(90deg, transparent, rgba(255,77,0,0.35), transparent); top: 0;"></div>

  <!-- HUD corner decorations -->
  <div class="absolute top-24 left-6 pointer-events-none hidden lg:block">
    <div class="w-16 h-16 border-l-2 border-t-2 border-zera-orange/30 rounded-tl-lg"></div>
    <div class="mt-2 text-zera-orange/40 text-xs font-mono tracking-widest">SYS.ONLINE</div>
  </div>
  <div class="absolute top-24 right-6 pointer-events-none hidden lg:block">
    <div class="w-16 h-16 border-r-2 border-t-2 border-zera-orange/30 rounded-tr-lg ml-auto"></div>
    <div class="mt-2 text-zera-orange/40 text-xs font-mono tracking-widest text-right">v3.0.0</div>
  </div>

  <!-- Two-column layout: text left, coin right -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 pt-28 pb-20 flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-0">
    
    <!-- Left: Text content -->
    <div class="flex-1 text-center lg:text-left max-w-2xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-zera-orange/20 mb-8 reveal-item" data-reveal>
        <span class="w-2 h-2 rounded-full bg-zera-orange animate-pulse shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
        <span class="text-sm font-medium text-white/80 tracking-wide">ZERA Network</span>
      </div>
      <!-- Main Title -->
      <h1 data-3d-text class="font-display font-bold text-4xl sm:text-5xl md:text-6xl lg:text-6xl xl:text-7xl leading-[1.05] tracking-tight mb-6">
        <span class="block hero-line overflow-hidden">
          <span class="inline-block hero-word">Community-Governed.</span>
        </span>
        <span class="block hero-line overflow-hidden">
          <span class="inline-block hero-word gradient-text">Treasury-Supported.</span>
        </span>
      </h1>
      <!-- Subtitle -->
      <p class="text-lg md:text-xl text-white/50 mb-10 reveal-item leading-relaxed" data-reveal>
        The ZERA Network is a modern, governance-first blockchain platform designed for high-performance, developer-friendly Web3 applications.
      </p>
      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-4 reveal-item" data-reveal>
        <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="group relative px-8 py-4 rounded-full bg-zera-orange text-white font-semibold text-lg overflow-hidden transition-all duration-300 hover:shadow-[0_0_40px_rgba(255,77,0,0.5)] hover:scale-105" data-magnetic>
          <span class="relative z-10 flex items-center gap-2">
            Join Community
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </span>
          <div class="absolute inset-0 bg-gradient-to-r from-zera-orange-light to-zera-amber opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </a>
        <a href="http://chatgpt.com/g/g-68a96e8daadc8191945582a504f0efe1-zera-gpt" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-full glass border border-white/10 text-white font-semibold text-lg hover:border-zera-orange/50 hover:bg-zera-orange/5 transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,77,0,0.2)]" data-magnetic>
          Try Zera GPT
        </a>
      </div>

      <!-- Tech stats row -->
      <div class="flex items-center gap-6 mt-10 reveal-item" data-reveal>
        <div class="flex flex-col">
          <span class="text-zera-orange font-bold text-xl font-mono">3K+</span>
          <span class="text-white/40 text-xs uppercase tracking-widest">TPS</span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div class="flex flex-col">
          <span class="text-zera-orange font-bold text-xl font-mono">$0.004</span>
          <span class="text-white/40 text-xs uppercase tracking-widest">Avg Fee</span>
        </div>
        <div class="w-px h-8 bg-white/10"></div>
        <div class="flex flex-col">
          <span class="text-zera-orange font-bold text-xl font-mono">100%</span>
          <span class="text-white/40 text-xs uppercase tracking-widest">On-Chain</span>
        </div>
      </div>
    </div>

    <!-- Right: 3D Network Globe -->
    <div class="flex-shrink-0 flex items-center justify-center lg:justify-end w-full lg:w-auto">
      <HeroGlobe />
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-40">
    <span class="text-xs uppercase tracking-widest text-white/50 font-mono">Scroll</span>
    <div class="w-6 h-10 rounded-full border border-white/30 flex items-start justify-center p-2">
      <div class="w-1.5 h-1.5 rounded-full bg-white/70 animate-bounce"></div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Scan line sweep
  const scanLine = document.getElementById('scan-line');
  if (scanLine) {
    gsap.to(scanLine, { top: '100%', duration: 4, repeat: -1, ease: 'none', delay: 1 });
  }

  // Hero title word reveal
  const heroWords = document.querySelectorAll('.hero-word');
  gsap.from(heroWords, { y: 100, opacity: 0, duration: 1.2, stagger: 0.18, ease: 'power4.out', delay: 0.4 });

  // Reveal animations
  const revealItems = document.querySelectorAll('#hero [data-reveal]');
  revealItems.forEach((item, i) => {
    gsap.from(item, { y: 40, opacity: 0, duration: 0.9, delay: 0.9 + i * 0.12, ease: 'power3.out' });
  });
</script>
