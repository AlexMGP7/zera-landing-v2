---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Gradient orb behind -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full blur-3xl pointer-events-none" style="background: radial-gradient(circle, rgba(255,77,0,0.2) 0%, rgba(255,77,0,0.05) 40%, transparent 70%);"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-zera-orange/20 mb-8 reveal-item">
      <span class="w-2 h-2 rounded-full bg-zera-orange animate-pulse shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
      <span class="text-sm font-medium text-white/80 tracking-wide">ZERA Network</span>
    </div>
    
    <!-- Main Title -->
    <h1 class="font-display font-bold text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.05] tracking-tight mb-6">
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word">Community-Governed.</span>
      </span>
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word gradient-text">Treasury-Supported.</span>
      </span>
    </h1>
    
    <!-- Subtitle -->
    <p class="max-w-2xl mx-auto text-lg md:text-xl text-white/60 mb-12 reveal-item leading-relaxed">
      The ZERA Network is a modern, governance-first blockchain platform designed for high-performance, developer-friendly Web3 applications.
    </p>
    
    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20 reveal-item">
      <a href="#community" class="group relative px-8 py-4 rounded-full bg-zera-orange text-white font-semibold text-lg overflow-hidden transition-all duration-300 hover:shadow-[0_0_40px_rgba(255,77,0,0.5)] hover:scale-105">
        <span class="relative z-10 flex items-center gap-2">
          Join Community
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-zera-orange-light to-zera-amber opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>
      
      <a href="#zera-gpt" class="px-8 py-4 rounded-full glass border border-white/10 text-white font-semibold text-lg hover:border-zera-orange/50 hover:bg-zera-orange/5 transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,77,0,0.2)]">
        Try Zera GPT
      </a>
    </div>
    
    <!-- 3D Logo -->
    <div class="relative w-48 h-48 md:w-64 md:h-64 mx-auto mb-16" style="perspective: 1000px;">
      <div id="logo-3d" class="w-full h-full transition-transform duration-100 ease-out" style="transform-style: preserve-3d;">
        <svg viewBox="0 0 239 304" class="w-full h-full drop-shadow-[0_0_30px_rgba(255,77,0,0.5)]" fill="none">
          <defs>
            <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff4d00"/>
              <stop offset="100%" stop-color="#ffa500"/>
            </linearGradient>
            <filter id="logoGlow">
              <feGaussianBlur stdDeviation="8" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <path d="M177.642 20.46c.523-1.959-1.865-3.363-3.322-1.954L19.558 168.062c-1.293 1.249-.409 3.438 1.39 3.438h64.89c2.047 0 3.493 2.006 2.846 3.949l-35.574 106.722c-.664 1.99 1.793 3.529 3.294 2.064l158.826-155.089c1.924-1.879.594-5.146-2.096-5.146h-60.53c-1.314 0-2.271-1.246-1.932-2.516l27.97-104.064Z" fill="url(#logoGrad)" filter="url(#logoGlow)"/>
        </svg>
      </div>
    </div>
    
    <!-- Stats teaser -->
    <div class="flex items-center justify-center gap-2 text-white/40 reveal-item">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      <span class="text-sm font-medium">800+ wallets - Create yours</span>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50 animate-bounce">
    <span class="text-xs uppercase tracking-widest text-white/50">Scroll</span>
    <svg class="w-5 h-5 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Logo 3D rotation on scroll
  const logo3d = document.getElementById('logo-3d');
  if (logo3d) {
    gsap.to(logo3d, {
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
      rotateY: 360,
      rotateX: 20,
      scale: 0.5,
      opacity: 0,
      ease: 'none',
    });

    // Floating animation
    gsap.to(logo3d, {
      y: -20,
      duration: 3,
      repeat: -1,
      yoyo: true,
      ease: 'power1.inOut',
    });
  }

  // Hero title word reveal
  const heroWords = document.querySelectorAll('.hero-word');
  gsap.from(heroWords, {
    y: 120,
    opacity: 0,
    duration: 1.2,
    stagger: 0.15,
    ease: 'power4.out',
    delay: 0.3,
  });

  // Reveal animations
  const revealItems = document.querySelectorAll('.reveal-item');
  revealItems.forEach((item, i) => {
    gsap.from(item, {
      y: 40,
      opacity: 0,
      duration: 0.8,
      delay: 0.8 + i * 0.1,
      ease: 'power3.out',
    });
  });
</script>
