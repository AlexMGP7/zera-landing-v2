---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Gradient orb behind for fallback -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[900px] rounded-full blur-3xl pointer-events-none opacity-60" style="background: radial-gradient(circle, rgba(255,77,0,0.18) 0%, rgba(255,77,0,0.04) 40%, transparent 70%);"></div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-6 py-32 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass border border-zera-orange/20 mb-10 reveal-item" data-reveal>
      <span class="w-2 h-2 rounded-full bg-zera-orange animate-pulse shadow-[0_0_8px_rgba(255,77,0,0.8)]"></span>
      <span class="text-sm font-medium text-white/80 tracking-wide">ZERA Network</span>
    </div>
    
    <!-- Main Title -->
    <h1 data-3d-text class="font-display font-bold text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl leading-[1.05] tracking-tight mb-8 preserve-3d">
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word">Community-Governed.</span>
      </span>
      <span class="block hero-line overflow-hidden">
        <span class="inline-block hero-word gradient-text">Treasury-Supported.</span>
      </span>
    </h1>
    
    <!-- Subtitle -->
    <p class="max-w-2xl mx-auto text-lg md:text-xl text-white/50 mb-14 reveal-item leading-relaxed" data-reveal>
      The ZERA Network is a modern, governance-first blockchain platform designed for high-performance, developer-friendly Web3 applications.
    </p>
    
    <!-- Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-5 mb-24 reveal-item" data-reveal>
      <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="group relative px-8 py-4 rounded-full bg-zera-orange text-white font-semibold text-lg overflow-hidden transition-all duration-300 hover:shadow-[0_0_40px_rgba(255,77,0,0.5)] hover:scale-105" data-magnetic>
        <span class="relative z-10 flex items-center gap-2">
          Join Community
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-zera-orange-light to-zera-amber opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>
      
      <a href="http://chatgpt.com/g/g-68a96e8daadc8191945582a504f0efe1-zera-gpt" target="_blank" rel="noopener noreferrer" class="px-8 py-4 rounded-full glass border border-white/10 text-white font-semibold text-lg hover:border-zera-orange/50 hover:bg-zera-orange/5 transition-all duration-300 hover:shadow-[0_0_30px_rgba(255,77,0,0.2)]" data-magnetic>
        Try Zera GPT
      </a>
    </div>
    
    <!-- 3D Logo with enhanced glow -->
    <div class="relative w-56 h-56 md:w-72 md:h-72 mx-auto mb-16" style="perspective: 1000px;">
      <div id="logo-3d" class="w-full h-full transition-transform duration-100 ease-out" style="transform-style: preserve-3d;">
        <svg viewBox="0 0 239 304" class="w-full h-full drop-shadow-[0_0_30px_rgba(255,77,0,0.5)]" fill="none">
          <defs>
            <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#ff4d00"/>
              <stop offset="100%" stop-color="#ffa500"/>
            </linearGradient>
            <filter id="logoGlow">
              <feGaussianBlur stdDeviation="10" result="blur"/>
              <feMerge>
                <feMergeNode in="blur"/>
                <feMergeNode in="blur"/>
                <feMergeNode in="SourceGraphic"/>
              </feMerge>
            </filter>
          </defs>
          <path d="M177.642 20.46c.523-1.959-1.865-3.363-3.322-1.954L19.558 168.062c-1.293 1.249-.409 3.438 1.39 3.438h64.89c2.047 0 3.493 2.006 2.846 3.949l-35.574 106.722c-.664 1.99 1.793 3.529 3.294 2.064l158.826-155.089c1.924-1.879.594-5.146-2.096-5.146h-60.53c-1.314 0-2.271-1.246-1.932-2.516l27.97-104.064Z" fill="url(#logoGrad)" filter="url(#logoGlow)"/>
        </svg>
      </div>
      <!-- Orbital rings -->
      <div class="absolute inset-0 pointer-events-none" style="transform-style: preserve-3d;">
        <div class="absolute inset-[-20%] rounded-full border border-zera-orange/10 animate-spin" style="animation-duration: 20s;"></div>
        <div class="absolute inset-[-35%] rounded-full border border-zera-orange/5 animate-spin" style="animation-duration: 30s; animation-direction: reverse;"></div>
      </div>
    </div>
    
    <!-- Stats teaser -->
    <div class="flex items-center justify-center gap-2 text-white/40 reveal-item" data-reveal>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
      </svg>
      <span class="text-sm font-medium">900+ wallets - <a href="https://visionhub.ch/" target="_blank" rel="noopener noreferrer" class="text-zera-orange hover:underline">Create yours</a></span>
    </div>
  </div>
  
  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-50">
    <span class="text-xs uppercase tracking-widest text-white/50">Scroll</span>
    <div class="w-6 h-10 rounded-full border border-white/30 flex items-start justify-center p-2">
      <div class="w-1.5 h-1.5 rounded-full bg-white/70 animate-bounce"></div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Logo 3D rotation on scroll
  const logo3d = document.getElementById('logo-3d');
  if (logo3d) {
    gsap.to(logo3d, {
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: 1,
      },
      rotateY: 360,
      rotateX: 20,
      scale: 0.5,
      opacity: 0,
      ease: 'none',
    });

    // Mouse tilt effect
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 20;
      const y = (e.clientY / window.innerHeight - 0.5) * 20;
      gsap.to(logo3d, {
        rotateY: x,
        rotateX: -y,
        duration: 0.8,
        ease: 'power2.out',
        overwrite: 'auto',
      });
    });
  }

  // Hero title word reveal
  const heroWords = document.querySelectorAll('.hero-word');
  gsap.from(heroWords, {
    y: 120,
    opacity: 0,
    duration: 1.4,
    stagger: 0.2,
    ease: 'power4.out',
    delay: 0.5,
  });

  // Reveal animations
  const revealItems = document.querySelectorAll('#hero [data-reveal]');
  revealItems.forEach((item, i) => {
    gsap.from(item, {
      y: 50,
      opacity: 0,
      duration: 1,
      delay: 1 + i * 0.15,
      ease: 'power3.out',
    });
  });
</script>
