---
// Ecosystem / Trust partners
const partners = [
  {
    name: 'SolidProof',
    role: 'Security Audit',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    name: 'Vision Hub',
    role: 'Wallet Provider',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`,
  },
  {
    name: 'Raydium',
    role: 'Liquidity Pool',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`,
  },
  {
    name: 'Solana',
    role: 'Bridge Partner',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>`,
  },
  {
    name: 'DexTools',
    role: 'Analytics',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z"/></svg>`,
  },
  {
    name: 'WASM',
    role: 'Smart Contract Engine',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`,
  },
];
---

<section id="ecosystem" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zera-orange/10 border border-zera-orange/20 text-zera-orange text-xs font-medium mb-4">
        Partners
      </div>
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">Trusted <span class="gradient-text">Ecosystem</span></h2>
      <p class="text-white/50 text-lg max-w-2xl mx-auto reveal-text">Built alongside industry-leading protocols and audited by top security firms.</p>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 perspective-container preserve-3d">
      {partners.map((partner, i) => (
        <div data-3d-card class="group relative reveal-card preserve-3d" data-index={i}>
          <div class="absolute inset-0 bg-gradient-to-br from-zera-orange/10 to-transparent rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          <div class="relative glass rounded-2xl p-6 border border-white/10 hover:border-zera-orange/20 transition-all duration-500 text-center h-full flex flex-col items-center justify-center gap-3">
            <div class="text-zera-orange/70 group-hover:text-zera-orange transition-colors group-hover:scale-110 duration-300">
              <Fragment set:html={partner.icon} />
            </div>
            <div>
              <div class="font-display font-bold text-sm text-white group-hover:text-zera-orange transition-colors">{partner.name}</div>
              <div class="text-white/30 text-xs">{partner.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('#ecosystem .reveal-card');
  cards.forEach((card, i) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 90%',
        toggleActions: 'play none none none',
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay: i * 0.08,
      ease: 'power3.out',
    });
  });
</script>
