---
---

<section id="developers" class="relative py-32 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <h2 class="font-display font-bold text-4xl md:text-5xl mb-4 reveal-text">See ZERA in <span class="gradient-text">Action</span></h2>
    </div>
    
    <div class="grid md:grid-cols-2 gap-8 perspective-container preserve-3d">
      <!-- Build dApps -->
      <div data-3d-card class="glass rounded-3xl p-8 md:p-12 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card preserve-3d">
        <div class="w-14 h-14 rounded-2xl bg-zera-orange/10 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-2xl md:text-3xl mb-4">Build dApps and Integrate ZERA</h3>
        <p class="text-white/60 leading-relaxed mb-8">
          Developers can build decentralized applications (dApps) on top of ZERA's infrastructure using the WASM smart contract engine.
        </p>
        <a href="https://t.me/zeranetwork" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-zera-orange/10 border border-zera-orange/30 text-zera-orange font-semibold hover:bg-zera-orange hover:text-white transition-all duration-300" data-magnetic>
          Join Community
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      
      <!-- Treasury -->
      <div data-3d-card id="treasury" class="glass rounded-3xl p-8 md:p-12 border border-white/10 hover:border-zera-orange/30 transition-all duration-500 group reveal-card preserve-3d">
        <div class="w-14 h-14 rounded-2xl bg-zera-orange/10 flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7 text-zera-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-2xl md:text-3xl mb-4">Treasury to Support the Protocol</h3>
        <p class="text-white/60 leading-relaxed mb-8">
          The ZERA Treasury is not a budget held by developers or a foundation. It's a public vault — transparent, and fully governed by users. Funded through network activity and governance. Decisions are made by community vote, not behind closed doors. No entity takes a cut. No insiders hold keys. The Treasury belongs to the network, not to a company.
        </p>
        <a href="https://zerascan.io/address/4Yg2ZeYrzMjVBXvU2YWtuZ7CzWR9atnQCD35TQj1kKcH" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-zera-orange font-semibold group/link" data-magnetic>
          View Treasury
          <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const cards = document.querySelectorAll('#developers .reveal-card, #developers .reveal-text');
  cards.forEach((card, i) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 50,
      opacity: 0,
      duration: 0.8,
      delay: i * 0.2,
      ease: 'power3.out',
    });
  });
</script>
