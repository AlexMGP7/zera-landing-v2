---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import ShaderBackground from '../components/ShaderBackground.astro';
import Hero from '../components/Hero.astro';
import LiveStatsBar from '../components/LiveStatsBar.astro';
import WhatIsZera from '../components/WhatIsZera.astro';
import Governance from '../components/Governance.astro';
import AuditBridge from '../components/AuditBridge.astro';
import Discover from '../components/Discover.astro';
import Metrics from '../components/Metrics.astro';
import Tokenomics from '../components/Tokenomics.astro';
import Features from '../components/Features.astro';
import Action from '../components/Action.astro';
import Overview from '../components/Overview.astro';
import GovernanceFeed from '../components/GovernanceFeed.astro';
import Roadmap from '../components/Roadmap.astro';
import EcosystemGrid from '../components/EcosystemGrid.astro';
import LearnMore from '../components/LearnMore.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <ShaderBackground />
  <Navbar />
  <main class="relative z-10">
    <Hero />

    <!-- Marquee scroller — tech aesthetic divider -->
    <div class="tech-marquee">
      <div class="tech-marquee-track">
        <span>Community-Governed <em class="dot not-italic">●</em> Treasury-Supported <em class="dot not-italic">●</em> Autonomous Execution <em class="dot not-italic">●</em> WASM Smart Contracts <em class="dot not-italic">●</em> Cross-Chain Ready <em class="dot not-italic">●</em> SolidProof Audited <em class="dot not-italic">●</em>&nbsp;</span>
        <span>Community-Governed <em class="dot not-italic">●</em> Treasury-Supported <em class="dot not-italic">●</em> Autonomous Execution <em class="dot not-italic">●</em> WASM Smart Contracts <em class="dot not-italic">●</em> Cross-Chain Ready <em class="dot not-italic">●</em> SolidProof Audited <em class="dot not-italic">●</em>&nbsp;</span>
      </div>
    </div>

    <LiveStatsBar />
    <WhatIsZera />
    <Governance />
    <GovernanceFeed />
    <AuditBridge />
    <Discover />
    <Metrics />
    <Tokenomics />
    <Roadmap />
    <Features />
    <EcosystemGrid />
    <Action />
    <Overview />
    <LearnMore />
  </main>
  <Footer />
</Layout>
