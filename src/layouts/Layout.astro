---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "ZERA Network - Community-Governed. Treasury-Supported.", 
  description = "ZERA Network is a 3rd generation blockchain that enables application development through a treasury-supported, collective governance protocol.",
  image = "/og-image.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#030201" />
  
  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdn.zerafile.io" />
  
  <!-- Preload critical fonts -->
  <link rel="preload" href="https://fonts.gstatic.com/s/spacegrotesk/v16/V8mQoQDjQSkFtoMM3T6r8E7mF71Q-gOoraIAEj7oUXskPMBBSSJLm2E.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="https://fonts.gstatic.com/s/inter/v18/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2" as="font" type="font/woff2" crossorigin />
  
  <!-- DNS Prefetch -->
  <link rel="dns-prefetch" href="https://zerascan.io" />
  <link rel="dns-prefetch" href="https://solscan.io" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="ZERA Network" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/png" href="/zera-landing-v2/logos/zera-logo-nav.png" />
  <title>{title}</title>
  
  <style is:inline>
    /* Critical CSS for no-FOUC */
    html.lenis, html.lenis body { height: auto; }
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
    .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
    .lenis.lenis-stopped { overflow: hidden; }
    
    /* Grain overlay */
    .grain-overlay {
      position: fixed;
      inset: 0;
      z-index: 9998;
      pointer-events: none;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 200px;
    }
    
    /* Loading state */
    body.loading { overflow: hidden; }
    .page-loader {
      position: fixed;
      inset: 0;
      z-index: 10001;
      background: #030201;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.8s cubic-bezier(0.76, 0, 0.24, 1), visibility 0.8s;
    }
    .page-loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* 3D Scroll effects base */
    .perspective-container {
      perspective: 1200px;
      perspective-origin: 50% 50%;
    }
    
    .preserve-3d {
      transform-style: preserve-3d;
    }
  </style>
</head>
<body class="bg-zera-black text-white antialiased">
  <!-- Page Loader -->
  <div id="page-loader" class="page-loader">
    <img src="/zera-landing-v2/logos/zera-logo-nav.png" alt="ZERA" class="w-16 h-16 animate-pulse object-contain" style="filter: drop-shadow(0 0 16px rgba(255,77,0,0.7));" />
  </div>
  
  <!-- Grain Overlay -->
  <div class="grain-overlay" aria-hidden="true"></div>
  
  <!-- Mouse spotlight -->
  <div id="mouse-spotlight" class="fixed inset-0 z-[55] pointer-events-none opacity-0 transition-opacity duration-500" style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,77,0,0.06), transparent 40%);"></div>

  <!-- Circuit board animated background -->
  <canvas id="circuit-canvas" class="fixed inset-0 pointer-events-none" style="z-index: 1; opacity: 0.35;"></canvas>

  <slot />
  
  <script>
    // Hide loader
    window.addEventListener('load', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        setTimeout(() => loader.classList.add('hidden'), 400);
      }
    });
  </script>
  
  <script>
    import Lenis from 'lenis';
    
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2,
    });
    
    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
    
    lenis.on('scroll', () => {
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.update();
      }
    });
    
    window.lenis = lenis;
    
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && href !== '#') {
          e.preventDefault();
          const target = document.querySelector(href);
          if (target) {
            lenis.scrollTo(target, { offset: -100 });
          }
        }
      });
    });
  </script>
  
  <script>
    // Mouse spotlight (kept, no custom cursor)
    let mouseTimeout;
    document.addEventListener('mousemove', (e) => {
      document.documentElement.style.setProperty('--mouse-x', e.clientX + 'px');
      document.documentElement.style.setProperty('--mouse-y', e.clientY + 'px');
      const spotlight = document.getElementById('mouse-spotlight');
      if (spotlight) spotlight.style.opacity = '1';
      
      clearTimeout(mouseTimeout);
      mouseTimeout = window.setTimeout(() => {
        if (spotlight) spotlight.style.opacity = '0';
      }, 2000);
    });
  </script>
  
  <script>
    // 3D Scroll effects — clean one-shot reveal (no scrub, no stuck opacity)
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Cards: reveal with opacity + margin-top (NO transform — tilt owns transform)
    const cards3D = document.querySelectorAll('[data-3d-card]');
    cards3D.forEach((card, i) => {
      const el = card as HTMLElement;
      el.style.opacity = '0';
      el.style.marginTop = '30px';
      el.style.transition = 'none';
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          const delay = (i % 3) * 0.07;
          gsap.to(el, {
            opacity: 1,
            marginTop: '0px',
            duration: 0.65,
            delay,
            ease: 'power3.out',
            onComplete: () => {
              // Clean up inline styles so tilt CSS works cleanly
              el.style.marginTop = '';
              el.style.transition = '';
            },
          });
        },
      });
    });

    // Texts: clean fade+rise
    const text3D = document.querySelectorAll('[data-3d-text]');
    text3D.forEach((text) => {
      gsap.set(text, { opacity: 0, y: 30 });
      ScrollTrigger.create({
        trigger: text,
        start: 'top 88%',
        once: true,
        onEnter: () => {
          gsap.to(text, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power3.out',
            clearProps: 'transform',
          });
        },
      });
    });
  </script>

  <script>
    // ── Global 3D tilt system ──────────────────────────────────────────────
    // Uses CSS custom properties so it never conflicts with GSAP animations.
    // Smooth RAF-based interpolation for 60fps without CSS transition jank.
    (function() {
      const TILT_MAX = 10; // degrees
      const LERP = 0.12;   // interpolation speed (lower = smoother)

      interface TiltState {
        targetX: number;
        targetY: number;
        currentX: number;
        currentY: number;
        rafId: number | null;
        active: boolean;
      }

      function initTilt(card: HTMLElement) {
        const state: TiltState = {
          targetX: 0, targetY: 0,
          currentX: 0, currentY: 0,
          rafId: null, active: false,
        };

        function animate() {
          state.currentX += (state.targetX - state.currentX) * LERP;
          state.currentY += (state.targetY - state.currentY) * LERP;

          card.style.setProperty('--tilt-x', state.currentX.toFixed(3) + 'deg');
          card.style.setProperty('--tilt-y', state.currentY.toFixed(3) + 'deg');

          const dist = Math.abs(state.targetX - state.currentX) + Math.abs(state.targetY - state.currentY);
          if (state.active || dist > 0.01) {
            state.rafId = requestAnimationFrame(animate);
          } else {
            state.rafId = null;
          }
        }

        card.addEventListener('mouseenter', () => {
          state.active = true;
          card.classList.remove('tilt-resetting');
          if (!state.rafId) state.rafId = requestAnimationFrame(animate);
        });

        card.addEventListener('mousemove', (e: MouseEvent) => {
          const r = card.getBoundingClientRect();
          const dx = (e.clientX - r.left - r.width / 2) / (r.width / 2);
          const dy = (e.clientY - r.top - r.height / 2) / (r.height / 2);
          state.targetX = -dy * TILT_MAX;
          state.targetY = dx * TILT_MAX;
          // Dynamic shadow
          card.style.boxShadow = `${dx * -8}px ${dy * -8}px 30px rgba(255,77,0,${0.08 + Math.abs(dx) * 0.06})`;
        });

        card.addEventListener('mouseleave', () => {
          state.active = false;
          state.targetX = 0;
          state.targetY = 0;
          card.classList.add('tilt-resetting');
          card.style.boxShadow = '';
          if (!state.rafId) state.rafId = requestAnimationFrame(animate);
          setTimeout(() => card.classList.remove('tilt-resetting'), 500);
        });
      }

      // Init on all tilt cards
      document.querySelectorAll('[data-tilt]').forEach((el) => {
        initTilt(el as HTMLElement);
      });
    })();
  </script>

  <script>
    // ── Circuit Board Animated Background ─────────────────────────────────
    // Draws a living PCB circuit pattern across the full page.
    // Nodes pulse, traces light up sequentially, energy packets travel along paths.
    (function() {
      const canvas = document.getElementById('circuit-canvas') as HTMLCanvasElement;
      if (!canvas) return;
      const ctx = canvas.getContext('2d')!;

      // Config
      const ORANGE = 'rgba(255, 120, 20,';
      const GRID = 55;          // grid cell size in px
      const NODE_PROB = 0.32;   // probability a grid intersection has a node
      const TRACE_PROB = 0.60;  // probability a connection between nodes exists
      const PACKET_COUNT = 28;  // number of energy packets traveling

      let W = 0, H = 0;
      let nodes: {x:number; y:number; pulse:number; pulseDir:number; brightness:number}[] = [];
      let traces: {ax:number; ay:number; bx:number; by:number; lit:number; litDir:number}[] = [];
      let packets: {traceIdx:number; t:number; speed:number; size:number}[] = [];

      function resize() {
        W = window.innerWidth;
        H = document.documentElement.scrollHeight;
        canvas.width = W;
        canvas.height = H;
        buildCircuit();
      }

      function buildCircuit() {
        nodes = [];
        traces = [];
        packets = [];

        // Build grid nodes
        const cols = Math.ceil(W / GRID) + 1;
        const rows = Math.ceil(H / GRID) + 1;
        const grid: (number | null)[][] = [];

        for (let r = 0; r < rows; r++) {
          grid[r] = [];
          for (let c = 0; c < cols; c++) {
            if (Math.random() < NODE_PROB) {
              grid[r][c] = nodes.length;
              nodes.push({
                x: c * GRID + (Math.random() - 0.5) * 12,
                y: r * GRID + (Math.random() - 0.5) * 12,
                pulse: Math.random(),
                pulseDir: Math.random() > 0.5 ? 1 : -1,
                brightness: 0.3 + Math.random() * 0.5,
              });
            } else {
              grid[r][c] = null;
            }
          }
        }

        // Build traces: connect adjacent nodes (horizontal + vertical + diagonal)
        const dirs = [[0,1],[1,0],[1,1],[1,-1]];
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            if (grid[r][c] === null) continue;
            const a = nodes[grid[r][c]!];
            for (const [dr, dc] of dirs) {
              const nr = r + dr, nc = c + dc;
              if (nr >= rows || nc < 0 || nc >= cols) continue;
              if (grid[nr][nc] === null) continue;
              if (Math.random() > TRACE_PROB) continue;
              const b = nodes[grid[nr][nc]!];
              traces.push({
                ax: a.x, ay: a.y, bx: b.x, by: b.y,
                lit: Math.random(),
                litDir: Math.random() > 0.5 ? 0.004 : -0.004,
              });
            }
          }
        }

        // Spawn energy packets
        for (let i = 0; i < PACKET_COUNT; i++) {
          if (traces.length === 0) break;
          packets.push({
            traceIdx: Math.floor(Math.random() * traces.length),
            t: Math.random(),
            speed: 0.002 + Math.random() * 0.004,
            size: 2 + Math.random() * 2,
          });
        }
      }

      function draw() {
        ctx.clearRect(0, 0, W, H);

        // Draw traces
        for (const tr of traces) {
          tr.lit += tr.litDir;
          if (tr.lit > 0.9 || tr.lit < 0.05) tr.litDir *= -1;
          const alpha = 0.12 + tr.lit * 0.35;
          ctx.beginPath();
          ctx.moveTo(tr.ax, tr.ay);
          ctx.lineTo(tr.bx, tr.by);
          ctx.strokeStyle = `${ORANGE}${alpha.toFixed(3)})`;
          ctx.lineWidth = 1.0;
          ctx.stroke();
        }

        // Draw nodes
        for (const nd of nodes) {
          nd.pulse += nd.pulseDir * 0.012;
          if (nd.pulse > 1) { nd.pulse = 1; nd.pulseDir = -1; }
          if (nd.pulse < 0) { nd.pulse = 0; nd.pulseDir = 1; }
          const alpha = 0.25 + nd.pulse * nd.brightness * 0.70;
          const r = 2 + nd.pulse * 2.5;
          // Outer glow
          const grad = ctx.createRadialGradient(nd.x, nd.y, 0, nd.x, nd.y, r * 4);
          grad.addColorStop(0, `${ORANGE}${(alpha * 0.8).toFixed(3)})`);
          grad.addColorStop(1, `${ORANGE}0)`);
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, r * 4, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
          // Core dot
          ctx.beginPath();
          ctx.arc(nd.x, nd.y, r, 0, Math.PI * 2);
          ctx.fillStyle = `${ORANGE}${alpha.toFixed(3)})`;
          ctx.fill();
        }

        // Draw energy packets
        for (const pk of packets) {
          pk.t += pk.speed;
          if (pk.t > 1) {
            pk.t = 0;
            pk.traceIdx = Math.floor(Math.random() * traces.length);
            pk.speed = 0.002 + Math.random() * 0.004;
          }
          const tr = traces[pk.traceIdx];
          if (!tr) continue;
          const x = tr.ax + (tr.bx - tr.ax) * pk.t;
          const y = tr.ay + (tr.by - tr.ay) * pk.t;
          // Bright packet glow
          const grad = ctx.createRadialGradient(x, y, 0, x, y, pk.size * 5);
          grad.addColorStop(0, `${ORANGE}0.9)`);
          grad.addColorStop(0.3, `${ORANGE}0.4)`);
          grad.addColorStop(1, `${ORANGE}0)`);
          ctx.beginPath();
          ctx.arc(x, y, pk.size * 5, 0, Math.PI * 2);
          ctx.fillStyle = grad;
          ctx.fill();
          // Core
          ctx.beginPath();
          ctx.arc(x, y, pk.size, 0, Math.PI * 2);
          ctx.fillStyle = `${ORANGE}1)`;
          ctx.fill();
        }

        requestAnimationFrame(draw);
      }

      // Rebuild on resize (debounced)
      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(resize, 300);
      });

      // Also rebuild when page height changes (e.g. lazy content)
      const ro = new ResizeObserver(() => {
        const newH = document.documentElement.scrollHeight;
        if (Math.abs(newH - H) > 100) resize();
      });
      ro.observe(document.body);

      resize();
      draw();
    })();
  </script>

</body>
</html>
