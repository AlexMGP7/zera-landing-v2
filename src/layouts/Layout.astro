---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "ZERA Network - Community-Governed. Treasury-Supported.", 
  description = "ZERA Network is a 3rd generation blockchain that enables application development through a treasury-supported, collective governance protocol.",
  image = "/og-image.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#030201" />
  
  <!-- Preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://cdn.zerafile.io" />
  
  <!-- Preload critical fonts -->
  <link rel="preload" href="https://fonts.gstatic.com/s/spacegrotesk/v16/V8mQoQDjQSkFtoMM3T6r8E7mF71Q-gOoraIAEj7oUXskPMBBSSJLm2E.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="https://fonts.gstatic.com/s/inter/v18/UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2" as="font" type="font/woff2" crossorigin />
  
  <!-- DNS Prefetch -->
  <link rel="dns-prefetch" href="https://zerascan.io" />
  <link rel="dns-prefetch" href="https://solscan.io" />
  
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="ZERA Network" />
  
  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  
  <!-- Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <link rel="icon" type="image/png" href="/zera-landing-v2/logos/zera-logo-nav.png" />
  <title>{title}</title>
  
  <style is:inline>
    /* Critical CSS for no-FOUC */
    html.lenis, html.lenis body { height: auto; }
    .lenis.lenis-smooth { scroll-behavior: auto !important; }
    .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
    .lenis.lenis-stopped { overflow: hidden; }
    
    /* Grain overlay */
    .grain-overlay {
      position: fixed;
      inset: 0;
      z-index: 9998;
      pointer-events: none;
      opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      background-repeat: repeat;
      background-size: 200px;
    }
    
    /* Loading state */
    body.loading { overflow: hidden; }
    .page-loader {
      position: fixed;
      inset: 0;
      z-index: 10001;
      background: #030201;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: opacity 0.8s cubic-bezier(0.76, 0, 0.24, 1), visibility 0.8s;
    }
    .page-loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /* 3D Scroll effects base */
    .perspective-container {
      perspective: 1200px;
      perspective-origin: 50% 50%;
    }
    
    .preserve-3d {
      transform-style: preserve-3d;
    }
  </style>
</head>
<body class="bg-zera-black text-white antialiased">
  <!-- Page Loader -->
  <div id="page-loader" class="page-loader">
    <img src="/zera-landing-v2/logos/zera-logo-nav.png" alt="ZERA" class="w-16 h-16 animate-pulse object-contain" style="filter: drop-shadow(0 0 16px rgba(255,77,0,0.7));" />
  </div>
  
  <!-- Grain Overlay -->
  <div class="grain-overlay" aria-hidden="true"></div>
  
  <!-- Mouse spotlight -->
  <div id="mouse-spotlight" class="fixed inset-0 z-[55] pointer-events-none opacity-0 transition-opacity duration-500" style="background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,77,0,0.06), transparent 40%);"></div>


  <slot />
  
  <script>
    // Hide loader
    window.addEventListener('load', () => {
      const loader = document.getElementById('page-loader');
      if (loader) {
        setTimeout(() => loader.classList.add('hidden'), 400);
      }
    });
  </script>
  
  <script>
    import Lenis from 'lenis';
    
    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      orientation: 'vertical',
      gestureOrientation: 'vertical',
      smoothWheel: true,
      wheelMultiplier: 1,
      touchMultiplier: 2,
    });
    
    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }
    requestAnimationFrame(raf);
    
    lenis.on('scroll', () => {
      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.update();
      }
    });
    
    window.lenis = lenis;
    
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        const href = anchor.getAttribute('href');
        if (href && href !== '#') {
          e.preventDefault();
          const target = document.querySelector(href);
          if (target) {
            lenis.scrollTo(target, { offset: -100 });
          }
        }
      });
    });
  </script>
  
  <script>
    // Mouse spotlight (kept, no custom cursor)
    let mouseTimeout;
    document.addEventListener('mousemove', (e) => {
      document.documentElement.style.setProperty('--mouse-x', e.clientX + 'px');
      document.documentElement.style.setProperty('--mouse-y', e.clientY + 'px');
      const spotlight = document.getElementById('mouse-spotlight');
      if (spotlight) spotlight.style.opacity = '1';
      
      clearTimeout(mouseTimeout);
      mouseTimeout = window.setTimeout(() => {
        if (spotlight) spotlight.style.opacity = '0';
      }, 2000);
    });
  </script>
  
  <script>
    // 3D Scroll effects — clean one-shot reveal (no scrub, no stuck opacity)
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Cards: reveal with opacity + margin-top (NO transform — tilt owns transform)
    const cards3D = document.querySelectorAll('[data-3d-card]');
    cards3D.forEach((card, i) => {
      const el = card as HTMLElement;
      el.style.opacity = '0';
      el.style.marginTop = '30px';
      el.style.transition = 'none';
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () => {
          const delay = (i % 3) * 0.07;
          gsap.to(el, {
            opacity: 1,
            marginTop: '0px',
            duration: 0.65,
            delay,
            ease: 'power3.out',
            onComplete: () => {
              // Clean up inline styles so tilt CSS works cleanly
              el.style.marginTop = '';
              el.style.transition = '';
            },
          });
        },
      });
    });

    // Texts: clean fade+rise
    const text3D = document.querySelectorAll('[data-3d-text]');
    text3D.forEach((text) => {
      gsap.set(text, { opacity: 0, y: 30 });
      ScrollTrigger.create({
        trigger: text,
        start: 'top 88%',
        once: true,
        onEnter: () => {
          gsap.to(text, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power3.out',
            clearProps: 'transform',
          });
        },
      });
    });
  </script>

  <script>
    // ── Global 3D tilt system ──────────────────────────────────────────────
    // Uses CSS custom properties so it never conflicts with GSAP animations.
    // Smooth RAF-based interpolation for 60fps without CSS transition jank.
    (function() {
      const TILT_MAX = 10; // degrees
      const LERP = 0.12;   // interpolation speed (lower = smoother)

      interface TiltState {
        targetX: number;
        targetY: number;
        currentX: number;
        currentY: number;
        rafId: number | null;
        active: boolean;
      }

      function initTilt(card: HTMLElement) {
        const state: TiltState = {
          targetX: 0, targetY: 0,
          currentX: 0, currentY: 0,
          rafId: null, active: false,
        };

        function animate() {
          state.currentX += (state.targetX - state.currentX) * LERP;
          state.currentY += (state.targetY - state.currentY) * LERP;

          card.style.setProperty('--tilt-x', state.currentX.toFixed(3) + 'deg');
          card.style.setProperty('--tilt-y', state.currentY.toFixed(3) + 'deg');

          const dist = Math.abs(state.targetX - state.currentX) + Math.abs(state.targetY - state.currentY);
          if (state.active || dist > 0.01) {
            state.rafId = requestAnimationFrame(animate);
          } else {
            state.rafId = null;
          }
        }

        card.addEventListener('mouseenter', () => {
          state.active = true;
          card.classList.remove('tilt-resetting');
          if (!state.rafId) state.rafId = requestAnimationFrame(animate);
        });

        card.addEventListener('mousemove', (e: MouseEvent) => {
          const r = card.getBoundingClientRect();
          const dx = (e.clientX - r.left - r.width / 2) / (r.width / 2);
          const dy = (e.clientY - r.top - r.height / 2) / (r.height / 2);
          state.targetX = -dy * TILT_MAX;
          state.targetY = dx * TILT_MAX;
          // Dynamic shadow
          card.style.boxShadow = `${dx * -8}px ${dy * -8}px 30px rgba(255,77,0,${0.08 + Math.abs(dx) * 0.06})`;
        });

        card.addEventListener('mouseleave', () => {
          state.active = false;
          state.targetX = 0;
          state.targetY = 0;
          card.classList.add('tilt-resetting');
          card.style.boxShadow = '';
          if (!state.rafId) state.rafId = requestAnimationFrame(animate);
          setTimeout(() => card.classList.remove('tilt-resetting'), 500);
        });
      }

      // Init on all tilt cards
      document.querySelectorAll('[data-tilt]').forEach((el) => {
        initTilt(el as HTMLElement);
      });
    })();
  </script>

  <script>
    // ── Localized Circuit Accents ─────────────────────────────────────────
    // Small animated circuit SVG corners that appear when a section enters viewport.
    // Each section with [data-circuit] gets 2 corner accents (top-left + bottom-right).
    (function() {
      // SVG path for a PCB corner trace (L-shaped with nodes)
      function makeCircuitSVG(flip: boolean): string {
        const t = flip ? 'scale(-1,-1) translate(-160,-160)' : '';
        return `<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160" fill="none">
          <g transform="${t}" opacity="0">
            <!-- Main L-trace -->
            <path d="M8 8 L8 60 L40 60 L40 90 L80 90 L80 120 L140 120" stroke="rgba(255,120,20,0.45)" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <animate attributeName="stroke-dasharray" from="0 400" to="400 0" dur="1.4s" fill="freeze" begin="0s"/>
            </path>
            <!-- Secondary branch -->
            <path d="M40 60 L70 60 L70 30 L110 30" stroke="rgba(255,120,20,0.25)" stroke-width="0.8" fill="none" stroke-linecap="round">
              <animate attributeName="stroke-dasharray" from="0 200" to="200 0" dur="1.1s" fill="freeze" begin="0.3s"/>
            </path>
            <!-- Tertiary branch -->
            <path d="M80 90 L80 70 L120 70 L120 50" stroke="rgba(255,120,20,0.2)" stroke-width="0.8" fill="none" stroke-linecap="round">
              <animate attributeName="stroke-dasharray" from="0 150" to="150 0" dur="0.9s" fill="freeze" begin="0.6s"/>
            </path>
            <!-- Nodes (circles at junctions) -->
            <circle cx="8" cy="8" r="3" fill="rgba(255,120,20,0.7)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="0s"/>
              <animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite" begin="1.4s"/>
            </circle>
            <circle cx="40" cy="60" r="2.5" fill="rgba(255,120,20,0.6)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="0.5s"/>
              <animate attributeName="r" values="2.5;4;2.5" dur="2.5s" repeatCount="indefinite" begin="1.4s"/>
            </circle>
            <circle cx="80" cy="90" r="2.5" fill="rgba(255,120,20,0.6)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="0.9s"/>
              <animate attributeName="r" values="2.5;4;2.5" dur="1.8s" repeatCount="indefinite" begin="1.4s"/>
            </circle>
            <circle cx="140" cy="120" r="3" fill="rgba(255,120,20,0.5)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="1.3s"/>
            </circle>
            <circle cx="70" cy="60" r="2" fill="rgba(255,120,20,0.4)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="0.7s"/>
            </circle>
            <circle cx="110" cy="30" r="2" fill="rgba(255,120,20,0.35)">
              <animate attributeName="opacity" values="0;1" dur="0.3s" fill="freeze" begin="1.0s"/>
            </circle>
            <!-- Energy packet traveling the main trace -->
            <circle r="3" fill="rgba(255,180,60,0.95)" filter="url(#glow)">
              <animateMotion dur="2s" repeatCount="indefinite" begin="1.5s">
                <mpath href="#main-trace-${flip ? 'b' : 'a'}"/>
              </animateMotion>
            </circle>
          </g>
          <defs>
            <filter id="glow">
              <feGaussianBlur stdDeviation="2.5" result="blur"/>
              <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <path id="main-trace-${flip ? 'b' : 'a'}" d="M8 8 L8 60 L40 60 L40 90 L80 90 L80 120 L140 120"/>
          </defs>
        </svg>`;
      }

      function injectCircuitAccents(section: HTMLElement) {
        // Top-left corner
        const tl = document.createElement('div');
        tl.className = 'circuit-accent circuit-tl';
        tl.style.cssText = 'position:absolute;top:0;left:0;width:160px;height:160px;pointer-events:none;z-index:2;opacity:0;transition:opacity 0.6s ease;';
        tl.innerHTML = makeCircuitSVG(false);

        // Bottom-right corner
        const br = document.createElement('div');
        br.className = 'circuit-accent circuit-br';
        br.style.cssText = 'position:absolute;bottom:0;right:0;width:160px;height:160px;pointer-events:none;z-index:2;opacity:0;transition:opacity 0.6s ease;transform:rotate(180deg);';
        br.innerHTML = makeCircuitSVG(true);

        section.appendChild(tl);
        section.appendChild(br);
        return { tl, br };
      }

      const sections = document.querySelectorAll('[data-circuit]');
      sections.forEach((sec) => {
        const section = sec as HTMLElement;
        // Ensure section is positioned
        if (getComputedStyle(section).position === 'static') {
          section.style.position = 'relative';
        }
        const { tl, br } = injectCircuitAccents(section);

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              // Fade in the accents and restart SVG animations
              tl.style.opacity = '1';
              br.style.opacity = '1';
              // Re-trigger SVG animations by cloning
              [tl, br].forEach(el => {
                const svgs = el.querySelectorAll('svg');
                svgs.forEach(svg => {
                  const clone = svg.cloneNode(true) as SVGElement;
                  // Show the inner group
                  const g = clone.querySelector('g');
                  if (g) g.style.opacity = '1';
                  svg.replaceWith(clone);
                });
              });
              observer.unobserve(section);
            }
          });
        }, { threshold: 0.15 });

        observer.observe(section);
      });
    })();
  </script>


</body>
</html>
